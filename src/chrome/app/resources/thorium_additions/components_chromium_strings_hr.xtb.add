<translation id="6398664274442544385">Gledate sigurnu stranicu Thoriuma</translation>
<translation id="2028209743487670346">Logotip Thoriuma</translation>
<translation id="7690933224612299375">Thorium omogućuju projekt utemeljen na otvorenom kôdu <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> i drugi <ph name="BEGIN_LINK_OSS" />softveri utemeljeni na otvorenom kôdu<ph name="END_LINK_OSS" />.</translation>
