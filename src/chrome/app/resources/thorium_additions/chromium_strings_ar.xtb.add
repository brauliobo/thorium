<translation id="6170145535196286635">‏عندما يطلب موقع إلكتروني تحميل الروابط في صفحته مسبقًا بخصوصية تامة، يستخدم Thorium خوادم Google. يؤدي هذا الإجراء إلى إخفاء هويتك عن الموقع الإلكتروني الذي يتم تحميله مسبقًا، ولكن تبقى Google على اطّلاع بالمواقع الإلكترونية التي يتم تحميلها مسبقًا.</translation>
<translation id="469847031616755573">‏Thorium هو متصفحك التلقائي</translation>
<translation id="9121116283800901015">‏لمحة عن Thorium</translation>
<translation id="7557415942066581350">‏عند تسجيل الدخول إلى خدمات Google، مثل Gmail أو YouTube باستخدام <ph name="USER_EMAIL" />، يمكنك تسجيل الدخول تلقائيًا إلى Thorium باستخدام الحساب نفسه</translation>
<translation id="8063674192889594521">‏إعداد ملفك الشخصي الجديد على Thorium</translation>
<translation id="2813532507332782105">‏أدوات الأمان في Thorium</translation>
<translation id="5404516918685923379">‏يمكنك مراجعة العناصر الرئيسية للتحكّم في الخصوصية والأمان في Thorium.</translation>
<translation id="391022854039785855">‏لحذف بيانات التصفّح من هذا الجهاز فقط والاحتفاظ بها في حسابك على Google، يُرجى <ph name="BEGIN_LINK" />تسجيل الخروج من Thorium<ph name="END_LINK" />.</translation>
<translation id="232337676435179638">‏من خلال إيقاف هذا الإعداد، يمكنك تسجيل الدخول إلى "مواقع Google" مثل Gmail بدون الحاجة إلى تسجيل الدخول إلى Thorium</translation>
<translation id="3879276044795274924">‏تخصيص Thorium</translation>
<translation id="6349701846617734224">‏باستخدام <ph name="BEGIN_LINK" />أدوات من Thorium<ph name="END_LINK" />، يمكنك التصفُّح بأمان والتحكُّم بشكل كامل بمعلوماتك الشخصية</translation>
<translation id="113825514187113500">‏في Thorium</translation>
<translation id="2513495859821894442">‏يمكنك تسجيل الدخول إلى Thorium للحصول على كلمات المرور وغيرها على جميع أجهزتك</translation>
<translation id="1290370037980749495">‏سيعمل Thorium بشكل أسرع ومن المفترض أن تعمل الميزات التي تستخدِم JavaScript على النحو المطلوب (خيار يُنصَح به).</translation>
<translation id="3203458745325150724">‏بياناتك على Thorium</translation>
<translation id="3892055234200984404">‏حو&amp;ل Thorium</translation>
<translation id="8312332850957380094">‏الملفات الشخصية الأخرى على Thorium</translation>
<translation id="2823243626069255310">‏يمكنك الآن تخصيص ملفك الشخصي الجديد على Thorium.</translation>
<translation id="7057723382073894700">‏V8 هو محرك JavaScript وWebAssembly من Thorium يُستخدَم لتحسين أداء المواقع الإلكترونية.</translation>
<translation id="9073817226409915222">‏استمرار تشغيل تطبيقات الخلفية عند إغلاق Thorium</translation>
<translation id="5737116114768420447">‏إدارة الملفات الشخصية على Thorium</translation>
<translation id="3390772469177266069">‏سيُعلِمك Thorium في حال العثور على اقتراحات مطلوب مراجعتها.</translation>
<translation id="253414695030364725">‏يُحمِّل Thorium مسبقًا الصفحات التي من المرجَح أن تزورها، وذلك بهدف تحميلها بسرعة أكبر عند زيارتك لها.</translation>
<translation id="1965458093883218976">‏تعرّف على الطريقة التي يحافظ بها Thorium على أمانك</translation>
<translation id="6097413908033623736">‏تحسين Thorium بالإبلاغ عن <ph name="BEGIN_LINK" />الإعدادات الحالية<ph name="END_LINK" /></translation>
<translation id="7153173282073382515">‏وضع التصفّح المتخفي في Thorium</translation>
<translation id="1861871537231630745">‏ستتلقّى تحذيرات بشأن المواقع الإلكترونية الخطيرة، بما فيها المواقع الإلكترونية التي لم يتعرّف عليها محرك بحث Google، من خلال تحليل قدر أكبر من البيانات الواردة من مواقع إلكترونية، مقارنةً بالحماية العادية. يمكنك اختيار تخطّي تحذيرات Thorium.</translation>
<translation id="8182056223343645142">‏تسجيل الخروج من Thorium</translation>
<translation id="4860412983011031251">‏الحصول على مساعدة في Thorium</translation>
<translation id="6079265919870015811">‏إضافة ملف شخصي على Thorium</translation>
<translation id="7473833913849364138">‏يُحمِّل Thorium الصفحات مسبقًا لزيادة سرعة التصفُّح والبحث. <ph name="BEGIN_LINK" />مزيد من المعلومات حول التحميل المُسبَق للصفحات<ph name="END_LINK" /></translation>
<translation id="898934820356659708">‏في حال مشاركة تقارير استخدام Thorium أيضًا، ستتضمّن هذه التقارير عناوين URL التي يتم الانتقال إليها.</translation>
<translation id="9072534646955460921">‏باستخدام ميزة الملفات الشخصية على Thorium، يمكنك الفصل بين جميع بيانات Thorium. وبإمكانك إنشاء ملفات شخصية للأصدقاء والعائلة أو الفصل بين البيانات المرتبطة بالعمل وتلك المرتبطة بالأنشطة الترفيهية.</translation>
<translation id="4308905027810063387">‏الخروج من Thorium</translation>
<translation id="6312135329022974196">‏الملفات الشخصية الأخرى على Thorium</translation>
<translation id="8828163608353368128">‏السماح بتسجيل الدخول إلى Thorium</translation>
<translation id="6497325017313227277">‏إزالة من Thorium</translation>
<translation id="8315496929814159292">‏تعيين Thorium المتصفح التلقائي</translation>
<translation id="438883585792992435">‏يفرِّغ Thorium الذاكرة من علامات التبويب غير النشطة. ويوفّر ذلك لعلامات التبويب النشطة والتطبيقات الأخرى مزيدًا من موارد الكمبيوتر للحفاظ على أداء Thorium السريع. سيُعاد تلقائيًا تنشيط علامات التبويب غير النشطة عند رجوعك إليها. <ph name="BEGIN_LINK" />مزيد من المعلومات حول ميزة "توفير الذاكرة"<ph name="END_LINK" /></translation>
<translation id="1318664233874758685">‏يتحقّق Thorium بانتظام من استخدام الإعدادات الأكثر أمانًا في متصفّحك. وسنُعلمك في حال كان عليك اتخاذ إجراء.</translation>
<translation id="4212981493728012253">‏لحماية بياناتك، يمكنك السماح لـ Thorium بإزالة الأذونات من المواقع الإلكترونية التي لم يتمّ زيارتها مؤخرًا. لا يؤدي تفعيل هذا الإعداد إلى إيقاف الإشعارات.</translation>
<translation id="3224040524634124542">‏في حال السماح بملفات تعريف الارتباط، قد يستخدمها Thorium في عملية التحميل المُسبق.</translation>
<translation id="1967056554017864811">‏تخصيص ملفك الشخصي في Thorium</translation>
<translation id="682714496634566410">‏تسمية ملفك الشخصي على Thorium</translation>
<translation id="1927215335595997320">‏يُحمِّل Thorium مسبقًا المزيد من الصفحات التي يُحتمل زيارتها، وذلك بهدف تحميلها بسرعة أكبر عند زيارتك لها.</translation>
<translation id="4344849281720725205">‏إذا حفظت أيضًا إشاراتك المرجعية في حسابك على Google، يمكنك تتبُّع أسعار المنتجات من خلال Thorium وتلقّي إشعارات عند انخفاض السعر.</translation>
<translation id="2905944704289173754">‏يمكنك مزامنة Thorium وتخصيصه على جميع أجهزتك.</translation>
<translation id="7023976647734322618">‏يمكنك جعل الاطّلاع على المواقع الإلكترونية التي تزورها أكثر صعوبة على الجهات التي يمكنها الوصول إلى حركة مرور بياناتك على الإنترنت. يستخدم Thorium اتصالاً آمنًا للبحث عن عنوان IP الخاص بأي موقع إلكتروني في نظام أسماء النطاقات (DNS).</translation>
<translation id="3124765553592510724">‏عند الكتابة في شريط العناوين أو مربّع البحث، يرسل Thorium ما تكتبه إلى محرك البحث التلقائي للحصول على اقتراحات أفضل. يتم إيقاف هذا الإعداد في "وضع التصفّح المتخفي".</translation>
<translation id="5501994443630499490">‏يمكنك تفعيل ميزة "الحماية الإضافية" في محرك JavaScript وWebAssembly من Thorium.</translation>
<translation id="3597078885567529815">‏<ph name="BEGIN_LINK" />يحذرك Thorium<ph name="END_LINK" /> بشأن المواقع الإلكترونية وعمليات التنزيل غير الآمنة</translation>
<translation id="6539171476340543682">‏لا يستطيع Thorium التحقُّق من كلمات المرور إلا عند حفظها.</translation>
<translation id="5422284534340886571">‏إضافة ملف شخصي على Thorium</translation>
<translation id="5346310914638900016">‏إدارة الملفات الشخصية على Thorium</translation>
<translation id="2601544977861663592">‏تسجيل الدخول إلى Thorium</translation>
<translation id="4933700843989736491">‏تسجيل الدخول إلى Thorium عند تسجيل الدخول إلى خدمات Google الأخرى</translation>
<translation id="7886351526956375471">‏مَن يستخدم Thorium؟</translation>
<translation id="6618835206810857815">حقوق الطبع والنشر <ph name="YEAR" /> Alex313031. جميع الحقوق محفوظة.</translation>
