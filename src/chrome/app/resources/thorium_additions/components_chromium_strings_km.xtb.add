<translation id="6398664274442544385">អ្នក​កំពុង​មើល​ទំព័រ Thorium ដែល​មាន​សុវត្ថិភាព</translation>
<translation id="2028209743487670346">និមិត្តសញ្ញា Thorium</translation>
<translation id="7690933224612299375">Thorium អាចបង្កើតឡើងបានដោយគម្រោងប្រភពបើកចំហរ <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> និង <ph name="BEGIN_LINK_OSS" />កម្មវិធីប្រភពបើកចំហរ<ph name="END_LINK_OSS" /> ផ្សេងទៀត។</translation>
