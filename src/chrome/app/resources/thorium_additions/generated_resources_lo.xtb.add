<translation id="7211644423940722034">ມີ Google ອັດສະລິຍະໃນ Thorium</translation>
<translation id="3235809737466786504">&amp;ຈັດການໂປຣໄຟລ໌ Thorium</translation>
<translation id="8440868410037477775">Thorium ແບບຄ່າເລີ່ມຕົ້ນ</translation>
<translation id="8409758214264627586">ມືດ</translation>
<translation id="2095085006197446924">Thorium ແລະ Labs...</translation>
<translation id="1046526951943141740">ໜ້ອຍ</translation>
<translation id="3203458745325150724">Thorium ຂອງທ່ານ</translation>
<translation id="3419566579770884237">ເພື່ອຊອກຫາເວັບໄຊສະເພາະໃດໜຶ່ງ ຫຼື ບາງສ່ວນຂອງ Thorium, ໃຫ້ພິມທາງລັດຂອງມັນໃສ່ໃນແຖບທີ່ຢູ່, ຕາມດ້ວຍຄີລັດທີ່ທ່ານຕ້ອງການ. ຕົວຢ່າງ: ເພື່ອຊອກຫາ Bookmarks ຢ່າງດຽວ, ໃຫ້ພິມ "@bookmarks", ຈາກນັ້ນກົດແຖບ ຫຼື ຍະຫວ່າງ.</translation>
<translation id="8312332850957380094">ໂປຣໄຟລ໌ Thorium ອື່ນໆ</translation>
<translation id="2705910091824419873">ປ່ຽນຮູບລັກຂອງ Thorium ແລະ ເສີມປະສິດທິພາບດ້ວຍ AI</translation>
<translation id="4244973288412043989">ເພື່ອຊອກຫາເວັບໄຊສະເພາະໃດໜຶ່ງ ຫຼື ບາງສ່ວນຂອງ Thorium, ໃຫ້ພິມທາງລັດຂອງມັນໃສ່ໃນແຖບທີ່ຢູ່, ຕາມດ້ວຍຄີລັດທີ່ທ່ານຕ້ອງການ.</translation>
<translation id="6515658523381740612">ຣິເຊັດການຕັ້ງຄ່າ</translation>
<translation id="6909308138379240311">&amp;ປັບແຕ່ງ Thorium ຂອງທ່ານ</translation>
<translation id="6497325017313227277">ເອົາ​ອອກ​ໄປຈາກ Thorium</translation>
<translation id="4507534546803388249">ເພື່ອສົ່ງແຖບນີ້ໄປຫາອຸປະກອນອື່ນ, ໃຫ້ເຂົ້າສູ່ລະບົບຫາ Thorium ຢູ່ບ່ອນນັ້ນ</translation>
<translation id="7380173295645268337">ອັບເດດຮູບແບບສີສັນເປັນ Thorium ເຊິ່ງເປັນຄ່າເລີ່ມຕົ້ນແລ້ວ</translation>
<translation id="5202896964479908972">ເພື່ອສົ່ງແຖບນີ້ໄປຫາອຸປະກອນອື່ນ, ໃຫ້ເຂົ້າສູ່ລະບົບຫາ Thorium ຢູ່ທັງສອງອຸປະກອນ</translation>
<translation id="1811162955796965480">ຣີເຊັດການຕັ້ງຄ່າບໍ?</translation>
<translation id="658517591826931316">ຣີເຊັດເປັນ Thorium ແບບຄ່າເລີ່ມຕົ້ນ</translation>
<translation id="6727504646834488816">&amp;ຈັດການໂປຣໄຟລ໌ Thorium</translation>
<translation id="6312135329022974196">ໂປຣໄຟລ໌ Thorium ອື່ນໆ</translation>
<translation id="1939792591028600650">ເລືອກອຸປະກອນ. ຈາກນັ້ນ, ເພື່ອເບິ່ງໜ້າ, ໃຫ້ເປີດ Thorium ຢູ່ບ່ອນນັ້ນ.</translation>
<translation id="2741756049856844611">&amp;ປັບແຕ່ງ Thorium ຂອງທ່ານ</translation>
<translation id="291763660622876378">ທີມງານກວດສອບອາດເຫັນຂໍ້ມູນທີ່ສົ່ງໄປຫາ Google ເພື່ອນຳໄປໃຊ້ປັບປຸງເທັກໂນໂລຢີຂອງ Thorium AI</translation>
<translation id="3879276044795274924">ປັບແຕ່ງ Thorium</translation>
<translation id="8401732857558278804">ເປີດລິ້ງຢູ່ໃນແຖບປັດຈຸບັນ</translation>
