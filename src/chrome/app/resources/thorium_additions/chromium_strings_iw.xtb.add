<translation id="6170145535196286635">‏כשאתר מבקש לטעון מראש קישורים בדף שלו באופן פרטי, מערכת Thorium משתמשת בשרתי Google. כך הזהות שלך מוסתרת מהאתר שנטען מראש, אבל Google יכולה לדעת אילו אתרים נטענים מראש.</translation>
<translation id="469847031616755573">‏‫Thorium מוגדר כדפדפן ברירת המחדל</translation>
<translation id="9121116283800901015">‏על Thorium</translation>
<translation id="7557415942066581350">‏כשנכנסים לשירותי Google כמו Gmail או YouTube עם <ph name="USER_EMAIL" />, אפשר להיכנס אוטומטית ל-Thorium עם אותו חשבון</translation>
<translation id="8063674192889594521">‏הגדרת הפרופיל החדש שלך ב-Thorium</translation>
<translation id="2813532507332782105">‏הכלים לבטיחות של Thorium</translation>
<translation id="5404516918685923379">‏בדיקה של אמצעי הבקרה החשובים ביותר על פרטיות ואבטחה ב-Thorium</translation>
<translation id="391022854039785855">‏כדי למחוק את נתוני הגלישה מהמכשיר הזה בלבד ועדיין לשמור אותם בחשבון Google שלך, <ph name="BEGIN_LINK" />עליך לצאת מהחשבון ב-Thorium<ph name="END_LINK" />.</translation>
<translation id="232337676435179638">‏אם תכבו את ההגדרה הזו, תוכלו להיכנס לאתרי Google, כמו Gmail, בלי להיכנס אל Thorium</translation>
<translation id="3879276044795274924">‏התאמה אישית של Thorium</translation>
<translation id="6349701846617734224">‏בעזרת <ph name="BEGIN_LINK" />הכלים של Thorium<ph name="END_LINK" /> אפשר לגלוש בבטחה ובשליטה</translation>
<translation id="113825514187113500">‏ב-Thorium</translation>
<translation id="2513495859821894442">‏כדי לקבל את הסיסמאות בכל המכשירים ועוד, יש להתחבר ל־Thorium.</translation>
<translation id="1290370037980749495">‏דפדפן Thorium פועל מהר יותר ותכונות שמשתמשות ב-JavaScript אמורות לפעול כמו שצריך (מומלץ)</translation>
<translation id="3203458745325150724">‏ה-Thorium שלך</translation>
<translation id="3892055234200984404">‏מידע על &amp;Thorium‏</translation>
<translation id="8312332850957380094">‏פרופילים אחרים ב-Thorium</translation>
<translation id="2823243626069255310">‏התאמה אישית של פרופיל Thorium החדש</translation>
<translation id="7057723382073894700">‏‫V8 הוא מנוע WebAssembly ו-JavaScript של Thorium שמשמש לשיפור ביצועי האתרים</translation>
<translation id="9073817226409915222">‏המשך הפעלת יישומים ברקע כאשר Thorium סגור</translation>
<translation id="5737116114768420447">‏ניהול הפרופילים ב-Thorium</translation>
<translation id="3390772469177266069">‏Thorium יעדכן אותך אם יש משהו שצריך לבדוק</translation>
<translation id="253414695030364725">‏כדי שהדפים שבהם מבקרים ייטענו מהר יותר, מערכת Thorium טוענת מראש דפים שיש סיכוי גבוה שייפתחו.</translation>
<translation id="1965458093883218976">‏איך מערכת Thorium שומרת על האבטחה שלך</translation>
<translation id="6097413908033623736">‏אפשר לעזור לשפר את Thorium על ידי דיווח על <ph name="BEGIN_LINK" />ההגדרות הנוכחיות<ph name="END_LINK" /></translation>
<translation id="7153173282073382515">‏מצב פרטי ב-Thorium</translation>
<translation id="1861871537231630745">‏מקבלים אזהרות לגבי אתרים מסוכנים, גם כאלה שלא היו ידועים ל-Google לפני כן, בעזרת ניתוח של יותר נתונים מאתרים בהשוואה להגנה הרגילה. אפשר לדלג על האזהרות מ-Thorium.</translation>
<translation id="8182056223343645142">‏יציאה מ-Thorium</translation>
<translation id="4860412983011031251">‏עזרה בנושא Thorium</translation>
<translation id="6079265919870015811">‏הוספת פרופיל Thorium</translation>
<translation id="7473833913849364138">‏‫Thorium טוען מראש דפים וכך ניתן לגלוש ולחפש מהר יותר. <ph name="BEGIN_LINK" />מידע נוסף על טעינה מראש של דפים<ph name="END_LINK" /></translation>
<translation id="898934820356659708">‏אם בחרת לשתף דוחות שימוש ב-Thorium, הם יכללו גם את כתובת ה-URL שביקרת בהם.</translation>
<translation id="9072534646955460921">‏פרופילים ב-Thorium, מפרידים את כל פריטי המידע ב-Thorium. אפשר ליצור פרופילים שמיועדים לחברים ולבני משפחה או להפריד בין עבודה ובילויים בשעות הפנאי.</translation>
<translation id="4308905027810063387">‏יציאה מ-Thorium</translation>
<translation id="6312135329022974196">‏פרופילים אחרים ב-Thorium</translation>
<translation id="8828163608353368128">‏התרת כניסה אל Thorium</translation>
<translation id="6497325017313227277">‏להסיר מ-‏Thorium‏</translation>
<translation id="8315496929814159292">‏הגדרת Thorium כדפדפן ברירת המחדל שלך</translation>
<translation id="438883585792992435">‏‫Thorium מפנה מקום בזיכרון שמוקצה לכרטיסיות לא פעילות. כך, לכרטיסיות הפעילות ולאפליקציות אחרות יש יותר משאבים מהמחשב ו-Thorium פועל מהר. כשחוזרים לכרטיסיות הלא פעילות, הן מופעלות מחדש באופן אוטומטי. <ph name="BEGIN_LINK" />מידע נוסף על מצב חיסכון בזיכרון<ph name="END_LINK" /></translation>
<translation id="1318664233874758685">‏Thorium בודק בקביעות כדי לוודא שלדפדפן יש את ההגדרות הבטוחות ביותר. נודיע לך אם צריך לבדוק משהו.</translation>
<translation id="4212981493728012253">‏כדי להגן על הנתונים שלך, מומלץ לאפשר ל-Thorium להסיר הרשאות מאתרים שלא נכנסת אליהם לאחרונה. המערכת תמשיך לשלוח התראות.</translation>
<translation id="3224040524634124542">‏אם מאפשרים שימוש בקובצי cookie, יכול להיות שמערכת Thorium תשתמש בהם במהלך טעינה מראש.</translation>
<translation id="1967056554017864811">‏התאמה אישית של פרופיל Thorium</translation>
<translation id="682714496634566410">‏בחירת שם לפרופיל Thorium שלך</translation>
<translation id="1927215335595997320">‏כדי שהדפים שבדרך כלל נכנסים אליהם ייטענו מהר יותר, מערכת Thorium טוענת מראש עוד יותר דפים שיש סיכוי גבוה שייפתחו.</translation>
<translation id="4344849281720725205">‏אם הסימניות שלך נשמרות גם בחשבון Google, יש לך אפשרות לעקוב אחרי מחירי מוצרים ב-Thorium ולקבל הודעות כשהמחירים יורדים</translation>
<translation id="2905944704289173754">‏סנכרון והתאמה אישית של Thorium בכל המכשירים</translation>
<translation id="7023976647734322618">‏לאנשים שיש להם גישה לתעבורת הנתונים שלך יהיה קשה יותר לראות את האתרים שביקרת בהם. ‫Thorium משתמש בחיבור מאובטח לחיפוש כתובות IP של אתרים ב-DNS.</translation>
<translation id="3124765553592510724">‏כשמקלידים טקסט בסרגל הכתובות או בתיבת החיפוש, Thorium שולח את הטקסט הזה למנוע החיפוש שמוגדר כברירת מחדל כדי לקבל הצעות טובות יותר. האפשרות הזו מושבתת במצב הפרטי.</translation>
<translation id="5501994443630499490">‏הפעלת הגנה נוספת במנוע WebAssembly ו-JavaScript של Thorium</translation>
<translation id="3597078885567529815">‏<ph name="BEGIN_LINK" />ב-Thorium מוצגות אזהרות<ph name="END_LINK" /> מפני הורדות ואתרים לא בטוחים</translation>
<translation id="6539171476340543682">‏כשיהיו סיסמאות שמורות, ל-Thorium תהיה אפשרות לבדוק אותן</translation>
<translation id="5422284534340886571">‏הוספת פרופיל Thorium</translation>
<translation id="5346310914638900016">‏ניהול הפרופילים ב-Thorium</translation>
<translation id="2601544977861663592">‏כניסה ל-Thorium</translation>
<translation id="4933700843989736491">‏בכניסה לשירותי Google מתבצעת כניסה גם ל-Thorium</translation>
<translation id="7886351526956375471">‏מי משתמש/ת ב-Thorium?</translation>
<translation id="6618835206810857815">זכויות יוצרים <ph name="YEAR" /> Alex313031. כל הזכויות שמורות.</translation>
