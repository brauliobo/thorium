<translation id="7211644423940722034">Thoriumமில் Google ஸ்மார்ட்களை பெறுக</translation>
<translation id="3235809737466786504">&amp;Thorium சுயவிவரங்களை நிர்வகிக்கவும்</translation>
<translation id="8440868410037477775">இயல்பு Thorium</translation>
<translation id="8409758214264627586">டார்க்</translation>
<translation id="2095085006197446924">Thorium &amp;Labs...</translation>
<translation id="1046526951943141740">லைட்</translation>
<translation id="3203458745325150724">உங்கள் Thorium</translation>
<translation id="3419566579770884237">குறிப்பிட்ட தளம் அல்லது Thorium பகுதியில் தேட, முகவரிப் பட்டியில் ஷார்ட்கட்டை டைப் செய்தபிறகு உங்களுக்கு விருப்பமான கீபோர்டு ஷார்ட்கட்டை டைப் செய்யவும். உதாரணத்திற்கு, புக்மார்க்குகளை மட்டும் தேட, "@bookmarks" என்று டைப் செய்தபிறகு Tab அல்லது Space பட்டனை அழுத்தவும்.</translation>
<translation id="8312332850957380094">பிற Thorium சுயவிவரங்கள்</translation>
<translation id="2705910091824419873">AI மூலம் மேம்படுத்தப்பட்ட Thorium</translation>
<translation id="4244973288412043989">குறிப்பிட்ட தளம் அல்லது Thorium பகுதியில் தேட, முகவரிப் பட்டியில் ஷார்ட்கட்டை டைப் செய்தபிறகு உங்களுக்கு விருப்பமான கீபோர்டு ஷார்ட்கட்டை டைப் செய்யவும்.</translation>
<translation id="6515658523381740612">அமைப்புகளை மீட்டமை</translation>
<translation id="6909308138379240311">Thorium உலாவியைப் பி&amp;ரத்தியேகமாக்குங்கள்</translation>
<translation id="6497325017313227277">Thoriumமிலிருந்து அகற்று</translation>
<translation id="4507534546803388249">இந்தப் பக்கத்தை மற்றொரு சாதனத்திற்கு அனுப்ப, அந்தச் சாதனத்திலிருக்கும் Thoriumமில் உள்நுழைய வேண்டும்</translation>
<translation id="7380173295645268337">இயல்பான Thorium தீமிற்கு மாற்றப்பட்டது</translation>
<translation id="5202896964479908972">இந்தப் பக்கத்தை மற்றொரு சாதனத்திற்கு அனுப்ப, இரண்டு சாதனங்களிலும் Thoriumமில் உள்நுழைய வேண்டும்</translation>
<translation id="1811162955796965480">அமைப்புகளை மீட்டமைக்க வேண்டுமா?</translation>
<translation id="658517591826931316">இயல்பு Thoriumமிற்கு மீட்டமை</translation>
<translation id="6727504646834488816">&amp;Thorium சுயவிவரங்களை நிர்வகிக்கவும்</translation>
<translation id="6312135329022974196">பிற Thorium சுயவிவரங்கள்</translation>
<translation id="1939792591028600650">சாதனத்தைத் தேர்வு செய்யவும். பிறகு, பக்கத்தைப் பார்க்க அதில் Thoriumமைத் திறக்கவும்.</translation>
<translation id="2741756049856844611">Thorium உலாவியைப் பி&amp;ரத்தியேகமாக்குங்கள்</translation>
<translation id="291763660622876378">Thorium AI தொழில்நுட்பத்தை மேம்படுத்துவதற்காக Googleளுக்கு அனுப்பப்படும் தரவு மதிப்பாய்வாளர்களுக்குக் காட்டப்படலாம்</translation>
<translation id="3879276044795274924">Thoriumமைப் பிரத்தியேகப்படுத்து</translation>
<translation id="8401732857558278804">இணைப்பை தற்போ&amp;தைய தாவலில் திற</translation>
