<translation id="6170145535196286635">როცა საიტი გთხოვთ, უფლება მისცეთ, კონფიდენციალურად ჩატვირთოს თავის გვერდზე არსებული ბმულები, Thorium გამოიყენებს Google-ის სერვერებს. აღნიშნული დამალავს თქვენს ვინაობას წინასწარ ჩატვირთული საიტისგან, თუმცა Google-ს ეცოდინება, რომელი საიტები იტვირთება წინასწარ.</translation>
<translation id="469847031616755573">Thorium თქვენი ნაგულისხმევი ბრაუზერია</translation>
<translation id="9121116283800901015">Thorium-ის შესახებ</translation>
<translation id="7557415942066581350">Google სერვისებში, მაგალითად, Gmail-სა თუ YouTube-ში <ph name="USER_EMAIL" />-ით შესვლისას შეგიძლიათ Thorium-შიც იმავე ანგარიშით შეხვიდეთ</translation>
<translation id="8063674192889594521">შექმენით ახალი Thorium პროფილი</translation>
<translation id="2813532507332782105">Thorium-ის უსაფრთხოების ხელსაწყოები</translation>
<translation id="5404516918685923379">გადახედეთ კონფიდენციალურობისა და უსაფრთხოების მართვის საკვანძო საშუალებებს Thorium-ში</translation>
<translation id="391022854039785855">დათვალიერების მონაცემების მხოლოდ ამ მოწყობილობიდან წასაშლელად და Google ანგარიშში მათ შესანარჩუნებლად <ph name="BEGIN_LINK" />გამოდით Thorium-იდან<ph name="END_LINK" />.</translation>
<translation id="232337676435179638">ამ პარამეტრის გამორთვის შემთხვევაში, Google-ის საიტებში (მაგალითად, Gmail-ში) შესვლას შეძლებთ Thorium-ში შესვლის გარეშე</translation>
<translation id="3879276044795274924">Thorium-ის მორგება</translation>
<translation id="6349701846617734224"><ph name="BEGIN_LINK" />Thorium-ში არსებული ხელსაწყოები<ph name="END_LINK" /> დაგეხმარებათ, უსაფრთხოდ დაათვალიეროთ ვები და შეინარჩუნოთ კონტროლი</translation>
<translation id="113825514187113500">Thorium-ში</translation>
<translation id="2513495859821894442">თქვენს ყველა მოწყობილობაზე პაროლებისა და სხვა კონტენტის მისაღებად შედით Thorium-ში</translation>
<translation id="1290370037980749495">Thorium უფრო სწრაფად, ხოლო ფუნქციები, რომლებიც JavaScript-ს იყენებს, დანიშნულებისამებრ იმუშავებს (რეკომენდებული)</translation>
<translation id="3203458745325150724">თქვენი Thorium</translation>
<translation id="3892055234200984404">Thorium-ის შ&amp;ესახებ</translation>
<translation id="8312332850957380094">სხვა Thorium პროფილები</translation>
<translation id="2823243626069255310">მოირგეთ თქვენი ახალი Thorium პროფილი</translation>
<translation id="7057723382073894700">V8 არის Thorium-ის JavaScript-ისა და WebAssembly-ს ძრავა, რომელიც საიტების წარმადობის გასაუმჯობესებლად გამოიყენება</translation>
<translation id="9073817226409915222">ფონური პროგრამების გაშვების გაგრძელება, როდესაც Thorium იხურება</translation>
<translation id="5737116114768420447">Thorium-ის პროფილების მართვა</translation>
<translation id="3390772469177266069">Thorium გაცნობებთ, თუ რაიმეს შემოწმება დაგჭირდებათ</translation>
<translation id="253414695030364725">Thorium წინასწარ ჩატვირთავს გვერდებს, რომელთა ნახვასაც, სავარაუდოდ, დააპირებთ — ამგვარად, ამ გვერდებზე გადასვლისას, ისინი უფრო სწრაფად ჩაიტვირთება</translation>
<translation id="1965458093883218976">შეიტყვეთ, როგორ ზრუნავს Thorium თქვენს უსაფრთხოებაზე</translation>
<translation id="6097413908033623736">ხელი შეუწყვეთ Thorium-ის გაუმჯობესებას <ph name="BEGIN_LINK" />მიმდინარე პარამეტრების<ph name="END_LINK" /> გამოგზავნის მეშვეობით</translation>
<translation id="7153173282073382515">Thorium-ის ინკოგნიტო რეჟიმი</translation>
<translation id="1861871537231630745">გაგაფრთხილებთ სახიფათო საიტების შესახებ (თუნდაც Google-ისთვის იქამდე უცნობის შესახებ) საიტებიდან იმაზე მეტი მონაცემის სკანირების მეშვეობით, ვიდრე სტანდარტული დაცვის შემთხვევაში. სურვილისამებრ, შეგიძლიათ გამოტოვოთ Thorium-ის გაფრთხილებები.</translation>
<translation id="8182056223343645142">Thorium-იდან გასვლა</translation>
<translation id="4860412983011031251">Thorium-თან დაკავშირებული დახმარების მიღება</translation>
<translation id="6079265919870015811">Thorium პროფილის დამატება</translation>
<translation id="7473833913849364138">Thorium წინასწარ ჩატვირთავს გვერდებს, რაც დააჩქარებს დათვალიერებას და ძიებას. <ph name="BEGIN_LINK" />შეიტყვეთ მეტი წინასწარ ჩატვირთული გვერდების შესახებ<ph name="END_LINK" /></translation>
<translation id="898934820356659708">თუ Thorium-ის მოხმარების ანგარიშებსაც გააზიარებთ, მათ თქვენ მიერ მონახულებულ URL-ებიც დაერთვება</translation>
<translation id="9072534646955460921">Thorium პროფილები Thorium-ში არსებული თქვენი კონტენტის განცალკევების საშუალებას გაძლევთ. შექმენით პროფილები ოჯახის წევრებისა და მეგობრებისთვის, ან განაცალკევეთ სამსახურებრივი და პირადი მონაცემები.</translation>
<translation id="4308905027810063387">Thorium-იდან გამოსვლა</translation>
<translation id="6312135329022974196">სხვა Thorium პროფილები</translation>
<translation id="8828163608353368128">Thorium-ში შესვლის დაშვება</translation>
<translation id="6497325017313227277">Thorium-იდან ამოღება</translation>
<translation id="8315496929814159292">დააყენეთ Thorium ნაგულისხმევ ბრაუზერად</translation>
<translation id="438883585792992435">Thorium გაასუფთავებს მეხსიერებას უმოქმედო ჩანართებიდან. აქტიურ ჩანართებსა და სხვა აპებს კომპიუტერის მეტი რესურსის გამოყენების საშუალება მიეცემა, რაც დააჩქარებს Thorium-საც. თქვენი არააქტიური ჩანართები ავტომატურად გააქტიურდება, როცა მათ დაუბრუნდებით. <ph name="BEGIN_LINK" />შეიტყვეთ მეტი მეხსიერების დამზოგის შესახებ<ph name="END_LINK" /></translation>
<translation id="1318664233874758685">Thorium რეგულარულად ამოწმებს, არის თუ არა თქვენს ბრაუზერში ყველაზე უსაფრთხო პარამეტრები. გაცნობებთ, თუ რაიმეს შემოწმება იქნება საჭირო.</translation>
<translation id="4212981493728012253">თქვენი მონაცემების დაცვის მიზნით, მიეცით საშუალება Thorium-ს გააუქმოს ნებართვები საიტებს, რომლებზეც ბოლო დროს არ გადასულხართ. აღნიშნული არ გათიშავს შეტყობინებების მიღების ფუნქციას.</translation>
<translation id="3224040524634124542">ქუქი-ჩანაწერების დაშვების შემთხვევაში, Thorium-მა, შესაძლოა, გამოიყენოს ისინი წინასწარ ჩატვირთვისთვის</translation>
<translation id="1967056554017864811">თქვენი Thorium პროფილის მორგება</translation>
<translation id="682714496634566410">დაასათაურეთ თქვენი Thorium პროფილი</translation>
<translation id="1927215335595997320">Thorium წინასწარ ჩატვირთავს უფრო მეტ გვერდს, რომელთა ნახვასაც, სავარაუდოდ, დააპირებთ — ამგვარად, ამ გვერდებზე გადასვლისას, ისინი უფრო სწრაფად ჩაიტვირთება</translation>
<translation id="4344849281720725205">თუ თქვენს სანიშნეებს Google ანგარიშშიც ინახავთ, შეგიძლიათ თვალი მიადევნოთ პროდუქტების ფასებს Thorium-ში და შეიტყოთ, როცა ფასი დაიკლებს</translation>
<translation id="2905944704289173754">მოახდინეთ Thorium-ის სინქრონიზაცია და პერსონალიზება თქვენს ყველა მოწყობილობას შორის</translation>
<translation id="7023976647734322618">გაურთულეთ თქვენ მიერ მონახულებული საიტების შესახებ ინფორმაციის ნახვა მათ, ვისაც წვდომა აქვს თქვენს ინტერნეტ-ტრაფიკზე. Thorium იყენებს უსაფრთო კავშირს საიტის IP მისამართის საპოვნელად DNS-ში (დომენური სახელების სისტემა).</translation>
<translation id="3124765553592510724">მისამართთა ზოლში ან საძიებო ველში ტექსტის აკრეფისას უკეთესი შემოთავაზებების მისაღებად Thorium თქვენ მიერ აკრეფილ ტექსტს გაუგზავნის თქვენს ნაგულისხმევ საძიებო სისტემას. აღნიშნული ფუნქცია გამორთულია ინკოგნიტო რეჟიმში.</translation>
<translation id="5501994443630499490">დამატებითი დაცვის ჩართვა Thorium-ის JavaScript-ისა და WebAssembly-ს ძრავაში</translation>
<translation id="3597078885567529815"><ph name="BEGIN_LINK" />Thorium გაგაფრთხილებთ<ph name="END_LINK" /> არაუსაფრთხო საიტებისა და ჩამოტვირთვების შესახებ</translation>
<translation id="6539171476340543682">პაროლების შემოწმებას Thorium შეძლებს მათი შენახვის შემდეგ</translation>
<translation id="5422284534340886571">Thorium პროფილის დამატება</translation>
<translation id="5346310914638900016">Thorium-ის პროფილების მართვა</translation>
<translation id="2601544977861663592">შედით Thorium-ში</translation>
<translation id="4933700843989736491">შედით Thorium-ში, როცა Google-ის სხვა სერვისებში შედიხართ</translation>
<translation id="7886351526956375471">ვინ იყენებს Thorium-ს?</translation>
<translation id="6618835206810857815">საავტორო უფლება <ph name="YEAR" /> Alex313031. ყველა უფლება დაცულია.</translation>
