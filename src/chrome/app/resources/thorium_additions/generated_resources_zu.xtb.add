<translation id="7211644423940722034">Thola okuhlakaniphile kwe-Google ku-Thorium</translation>
<translation id="3235809737466786504">&amp;Phatha amaphrofayela e-Thorium</translation>
<translation id="8440868410037477775">I-Thorium Ezenzakalelayo</translation>
<translation id="8409758214264627586">Mnyama</translation>
<translation id="2095085006197446924">I-Thorium Namalebhu...</translation>
<translation id="1046526951943141740">Ukukhanya</translation>
<translation id="3203458745325150724">IThorium Yakho</translation>
<translation id="3419566579770884237">Ukusetha isayithi noma ingxenye ethile ye-Thorium, thayipha isinqamuleli sayo kubha yekheli, kulandelwa isinqamuleli sekhibhodi esincanyelwayo. Ngokwesiobnelo, ukusesha Amabhukhi kuphela, thayipha okuthi "@bookmarks", bese ucindezela u-Tab noma u-Space.</translation>
<translation id="8312332850957380094">Amanye amaphrofayili e-Thorium</translation>
<translation id="2705910091824419873">Buka kabusha iThorium, efakwe amandla we-AI</translation>
<translation id="4244973288412043989">Ukusetha isayithi noma ingxenye ethile ye-Thorium, thayipha isinqamuleli sayo kubha yekheli, kulandelwa isinqamuleli sekhibhodi esincanyelwayo.</translation>
<translation id="6515658523381740612">Setha kabusha izilungiselelo</translation>
<translation id="6909308138379240311">Enza ngendlela oyifisayo i-Thorium Yakho</translation>
<translation id="6497325017313227277">Susa kusuka ku-Thorium</translation>
<translation id="4507534546803388249">Ukuze uthumele le thebhu kwenye idivayisi, ngena ngemvume ku-Thorium lapho</translation>
<translation id="7380173295645268337">Itimu ibuyekezelwe kuThorium Ezenzakalelayo</translation>
<translation id="5202896964479908972">Ukuze uthumele le thebhu kwenye idivayisi, ngena ngemvume ku-Thorium kuwo womabili amadivayisi</translation>
<translation id="1811162955796965480">Setha kabusha amasethingi?</translation>
<translation id="658517591826931316">Setha Kabusha I-Thorium Ngokuzenzakalelayo</translation>
<translation id="6727504646834488816">&amp;Phatha Amaphrofayela e-Thorium</translation>
<translation id="6312135329022974196">Amanye Amaphrofayili e-Thorium</translation>
<translation id="1939792591028600650">Khetha idivayisi. Bese, ukuze ubone ikhasi, vula i-Thorium lapho.</translation>
<translation id="2741756049856844611">Enza ngendlela oyifisayo i-Thorium yakho</translation>
<translation id="291763660622876378">Idatha ethunyelwa kuGoogle ingase ibonwe ababuyekezi abangabantu ukuze kuthuthukiswe ubuchwepheshe be-AI yeThorium</translation>
<translation id="3879276044795274924">Yenza i-Thorium ngokwezifiso</translation>
<translation id="8401732857558278804">Vula isixhumanisi kuthebhu yangoku</translation>
