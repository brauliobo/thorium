<translation id="6170145535196286635">‏وقتی سایتی برای پیش‌بارگیری خصوصی پیوندها در صفحه خود درخواست می‌دهد، Thorium از سرورهای Google استفاده می‌کند. با این کار هویتتان از دید سایت پیش‌بارگیری‌شده پنهان می‌شود، اما Google متوجه می‌شود که چه سایت‌هایی پیش‌بارگیری شده‌اند.</translation>
<translation id="469847031616755573">‏Thorium مرورگر پیش‌فرضتان است</translation>
<translation id="9121116283800901015">‏درباره Thorium</translation>
<translation id="7557415942066581350">‏وقتی با <ph name="USER_EMAIL" /> به سیستم سرویس‌های Google مثل Gmail یا YouTube وارد می‌شوید، می‌توانید به‌طور خودکار با همان حساب به سیستم Thorium وارد شوید</translation>
<translation id="8063674192889594521">‏راه‌اندازی نمایه Thorium جدید</translation>
<translation id="2813532507332782105">‏ابزارهای ایمنی Thorium</translation>
<translation id="5404516918685923379">‏مرور کنترل‌های اصلی امنیت و حریم خصوصی در Thorium</translation>
<translation id="391022854039785855">‏برای حذف کردن داده‌های مرور فقط از این دستگاه و نگهداری آن در «حساب Google»، <ph name="BEGIN_LINK" />از سیستم Thorium خارج شوید<ph name="END_LINK" />.</translation>
<translation id="232337676435179638">‏با خاموش کردن این گزینه، می‌توانید بدون ورود به سیستم Thorium به سیستم سایت‌های Google مانند Gmail وارد شوید</translation>
<translation id="3879276044795274924">‏سفارشی کردن Thorium</translation>
<translation id="6349701846617734224">‏با <ph name="BEGIN_LINK" />ابزارهای Thorium<ph name="END_LINK" />، می‌توانید به‌طور ایمن مرور کنید و کنترل را دردست بگیرید</translation>
<translation id="113825514187113500">‏در Thorium</translation>
<translation id="2513495859821894442">‏برای دریافت گذرواژه‌ها و موارد دیگر در همه دستگاه‌هایتان، به سیستم Thorium وارد شوید</translation>
<translation id="1290370037980749495">‏Thorium سریع‌تر اجرا می‌شود و ویژگی‌هایی که از جاوا اسکریپت استفاده می‌کنند باید طبق طراحی کار کنند (توصیه می‌شود)</translation>
<translation id="3203458745325150724">‏‫Thorium شما</translation>
<translation id="3892055234200984404">‏درباره &amp;Thorium</translation>
<translation id="8312332850957380094">‏دیگر نمایه‌های Thorium</translation>
<translation id="2823243626069255310">‏سفارشی کردن نمایه جدید Thorium</translation>
<translation id="7057723382073894700">‏V8 موتور WebAssembly و جاوا اسکریپت Thorium است که از آن برای بهبود عملکرد سایت استفاده می‌شود</translation>
<translation id="9073817226409915222">‏ادامه اجرای برنامه‌ها در پس‌زمینه هنگامیکه Thorium بسته می‌شود</translation>
<translation id="5737116114768420447">‏مدیریت نمایه‌های Thorium</translation>
<translation id="3390772469177266069">‏اگر موردی نیاز به بررسی داشته باشد، Thorium به شما اطلاع می‌دهد</translation>
<translation id="253414695030364725">‏‫Thorium صفحه‌هایی را که احتمالاً از آن‌ها بازدید خواهید کرد پیش‌بارگیری می‌کند تا وقتی از آن‌ها بازدید می‌کنید سریع‌تر بارگیری شوند</translation>
<translation id="1965458093883218976">‏ببینید Thorium چگونه ایمنی شما را حفظ می‌کند</translation>
<translation id="6097413908033623736">‏با گزارش <ph name="BEGIN_LINK" />تنظیمات کنونی<ph name="END_LINK" />، به بهتر شدن Thorium کمک کنید</translation>
<translation id="7153173282073382515">‏حالت ناشناس Thorium</translation>
<translation id="1861871537231630745">‏با تجزیه‌وتحلیل داده‌های بیشتری از سایت‌ها در مقایسه با محافظت استاندارد، درباره سایت‌های خطرناک به شما هشدار می‌دهد، حتی سایت‌هایی که Google قبلاً از آن‌ها اطلاعی نداشته است. می‌توانید هشدارهای Thorium را رد کنید.</translation>
<translation id="8182056223343645142">‏خروج از سیستم Thorium</translation>
<translation id="4860412983011031251">‏دریافت کمک برای Thorium</translation>
<translation id="6079265919870015811">‏افزودن نمایه Thorium</translation>
<translation id="7473833913849364138">‏‫Thorium صفحه‌ها را پیش‌بارگیری می‌کند تا مرور و جستجو کردن سریع‌تر شود. <ph name="BEGIN_LINK" />درباره پیش‌بارگیری صفحه‌ها بیشتر بدانید<ph name="END_LINK" /></translation>
<translation id="898934820356659708">‏اگر گزارش‌های استفاده از Thorium را نیز هم‌رسانی کنید، این گزارش‌ها نشانی‌های وبی را که بازدید می‌کنید دربرمی‌گیرد</translation>
<translation id="9072534646955460921">‏با نمایه‌های Thorium می‌توانید همه چیزهای مربوط به Thorium را از هم جدا کنید. برای دوستان و اعضای خانواده نمایه ایجاد کنید، یا کار و سرگرمی را ازهم جدا کنید.</translation>
<translation id="4308905027810063387">‏خروج از سیستم Thorium</translation>
<translation id="6312135329022974196">‏دیگر نمایه‌های Thorium</translation>
<translation id="8828163608353368128">‏مجاز کردن ورود به سیستم Thorium</translation>
<translation id="6497325017313227277">‏حذف از Thorium</translation>
<translation id="8315496929814159292">‏تنظیم Thorium به عنوان مرورگر پیش‌فرضتان</translation>
<translation id="438883585792992435">‏‫Thorium حافظه را از برگه‌های غیرفعال آزاد می‌کند. با این کار، منابع بیشتری در رایانه به برگه‌های فعال و سایر برنامه‌ها اختصاص داده می‌شود و سرعت بالای Thorium حفظ می‌شود. هرزمان به برگه‌های غیرفعال برگردید، به‌طور خودکار دوباره فعال می‌شوند. <ph name="BEGIN_LINK" />درباره «بهینه‌سازی حافظه» بیشتر بدانید<ph name="END_LINK" /></translation>
<translation id="1318664233874758685">‏Thorium به‌طور منظم بررسی می‌کند تا مطمئن شود مرورگرتان ایمن‌ترین تنظیمات را دارد. اگر موردی به بازبینی شما نیاز داشته باشد، به شما اطلاع خواهیم داد.</translation>
<translation id="4212981493728012253">‏برای محافظت از داده‌هایتان، به Thorium اجازه داده می‌شود اجازه‌های سایت‌هایی را که اخیراً از آن‌ها بازدید نکرده‌اید حذف کند. اعلان‌ها متوقف نمی‌شود.</translation>
<translation id="3224040524634124542">‏اگر کوکی‌ها را مجاز کنید، ممکن است Thorium از آن‌ها هنگام پیش‌بارگیری استفاده کند</translation>
<translation id="1967056554017864811">‏سفارشی کردن نمایه Thorium</translation>
<translation id="682714496634566410">‏نام‌گذاری نمایه Thorium</translation>
<translation id="1927215335595997320">‏‫Thorium صفحه‌های بیشتری را که احتمالاً از آن‌ها بازدید خواهید کرد پیش‌بارگیری می‌کند تا وقتی از آن‌ها بازدید می‌کنید سریع‌تر بارگیری شوند</translation>
<translation id="4344849281720725205">‏اگر نشانک‌ها را در «حساب Google» هم ذخیره کنید، می‌توانید قیمت محصولات را در Thorium پیگیری کنید و از کاهش قیمت‌ها مطلع شوید</translation>
<translation id="2905944704289173754">‏Thorium را در همه دستگاه‌هایتان همگام‌سازی و شخصی‌سازی کنید</translation>
<translation id="7023976647734322618">‏شرایط را سخت‌تر کنید تا افرادی که به ترافیک اینترنت شما دسترسی دارند نتوانند سایت‌هایی را که بازدید می‌کنید ببینند. ‫Thorium برای جستجوی نشانی IP سایت در ساناد (سیستم نامگذاری دامنه) از اتصال ایمنی استفاده می‌کند.</translation>
<translation id="3124765553592510724">‏وقتی در نوار نشانی یا چارگوش جستجو تایپ می‌کنید، Thorium آنچه تایپ می‌کنید را به موتور جستجوی پیش‌فرض شما ارسال می‌کند تا پیشنهادهای بهتری دریافت کند. این ویژگی در «حالت ناشناس» خاموش است.</translation>
<translation id="5501994443630499490">‏روشن کردن محافظت بیشتر در موتور WebAssembly و جاوا اسکریپت Thorium</translation>
<translation id="3597078885567529815">‏‫Thorium درباره سایت‌ها و بارگیری‌های ناامن <ph name="BEGIN_LINK" />به شما هشدار می‌دهد<ph name="END_LINK" /></translation>
<translation id="6539171476340543682">‏‫Thorium زمانی می‌تواند گذرواژه‌هایتان را بررسی کند که آن‌ها را ذخیره کرده باشید</translation>
<translation id="5422284534340886571">‏افزودن نمایه Thorium</translation>
<translation id="5346310914638900016">‏مدیریت نمایه‌های Thorium</translation>
<translation id="2601544977861663592">‏ورود به سیستم Thorium</translation>
<translation id="4933700843989736491">‏ورود به سیستم Thorium هنگام وارد شدن به سیستم دیگر سرویس‌های Google</translation>
<translation id="7886351526956375471">‏چه‌کسی از Thorium استفاده می‌کند؟</translation>
<translation id="6618835206810857815">حق نشر <ph name="YEAR" /> Alex313031. تمام حقوق محفوظ است.</translation>
