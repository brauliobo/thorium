<translation id="6170145535196286635">જ્યારે કોઈ સાઇટ તેના પેજ પર લિંક ખાનગી રીતે પહેલેથી લોડ કરવાનું પૂછે, ત્યારે Thorium Google સર્વરનો ઉપયોગ કરે છે. આ તમારી ઓળખ પહેલેથી લોડ કરેલી સાઇટથી છુપાવે છે, પણ Googleને એ જાણવા મળે છે કે કઈ સાઇટ પહેલેથી લોડ કરવામાં આવે છે.</translation>
<translation id="469847031616755573">Thorium તમારું ડિફૉલ્ટ બ્રાઉઝર છે</translation>
<translation id="9121116283800901015">Thorium વિશે</translation>
<translation id="7557415942066581350">Gmail કે YouTube જેવી Googleની સેવાઓમાં <ph name="USER_EMAIL" /> વડે સાઇન ઇન કરતી વખતે, તમે એ જ એકાઉન્ટ વડે Thoriumમાં ઑટોમૅટિક રીતે સાઇન ઇન કરી શકો છો</translation>
<translation id="8063674192889594521">તમારી નવી Thorium પ્રોફાઇલ સેટઅપ કરો</translation>
<translation id="2813532507332782105">Thoriumના સલામતી માટેના ટૂલ</translation>
<translation id="5404516918685923379">Thoriumમાં પ્રાઇવસી અને સુરક્ષા સંબંધિત મુખ્ય નિયંત્રણોનો રિવ્યૂ કરો</translation>
<translation id="391022854039785855">તમારા Google એકાઉન્ટમાં બ્રાઉઝિંગ ડેટા રાખીને તેને માત્ર આ ડિવાઇસમાંથી ડિલીટ કરવા માટે, <ph name="BEGIN_LINK" />Thoriumમાંથી સાઇન આઉટ કરો<ph name="END_LINK" />.</translation>
<translation id="232337676435179638">આને બંધ કરવાથી, તમે Thoriumમાં સાઇન ઇન કર્યા સિવાય Gmail જેવી Googleની સાઇટમાં સાઇન ઇન કરી શકશો</translation>
<translation id="3879276044795274924">Thorium કસ્ટમાઇઝ કરો</translation>
<translation id="6349701846617734224"><ph name="BEGIN_LINK" />Thoriumના ટૂલ<ph name="END_LINK" /> વડે, તમે સલામત રીતે બ્રાઉઝ કરી શકો છો તેમજ નિયંત્રણ જાળવી શકો છો</translation>
<translation id="113825514187113500">Thorium માં</translation>
<translation id="2513495859821894442">તમારા બધા ડિવાઇસ પર તમારા પાસવર્ડ અને બીજું ઘણું મેળવવા માટે, Thoriumમાં સાઇન ઇન કરો</translation>
<translation id="1290370037980749495">Thorium વધુ ઝડપથી કામ કરે છે અને JavaScriptનો ઉપયોગ કરતી સુવિધાઓ ડિઝાઇન પ્રમાણે કામ કરવી જોઈએ (સુઝાવ આપવામાં આવે છે)</translation>
<translation id="3203458745325150724">તમારું Thorium</translation>
<translation id="3892055234200984404">&amp;Thorium વિશે</translation>
<translation id="8312332850957380094">અન્ય Thorium પ્રોફાઇલ</translation>
<translation id="2823243626069255310">તમારી નવી Thorium પ્રોફાઇલ કસ્ટમાઇઝ કરો</translation>
<translation id="7057723382073894700">V8 એ Thoriumનું JavaScript અને WebAssembly એન્જિન છે જેનો ઉપયોગ સાઇટનું પર્ફોર્મન્સ બહેતર બનાવવા માટે થાય છે</translation>
<translation id="9073817226409915222">જ્યારે Thorium બંધ થાય ત્યારે બૅકગ્રાઉન્ડ ઍપ ચલાવવાનું ચાલુ રાખો</translation>
<translation id="5737116114768420447">Thorium પ્રોફાઇલ મેનેજ કરો</translation>
<translation id="3390772469177266069">જો કંઈપણ માટે તમારા રિવ્યૂની જરૂર હોય, તો Thorium તમને જણાવશે</translation>
<translation id="253414695030364725">તમે જે પેજની મુલાકાત લેવાની શક્યતા વધુ હોય, Thorium તેને પહેલેથી લોડ કરે છે, જેથી જ્યારે તમે તેમની મુલાકાત લો, ત્યારે તે વધુ ઝડપથી લોડ થઈ શકે</translation>
<translation id="1965458093883218976">Thoriumની તમને સલામત રાખવાની રીત વિશે જાણો</translation>
<translation id="6097413908033623736"><ph name="BEGIN_LINK" />વર્તમાન સેટિંગ<ph name="END_LINK" />ની જાણ કરીને Thoriumને બહેતર બનાવવામાં સહાય કરો</translation>
<translation id="7153173282073382515">Thorium છૂપો મોડ</translation>
<translation id="1861871537231630745">સાઇટ પરથી માનક સંરક્ષણ કરતા વધુ ડેટા વિશ્લેષિત કરીને, Googleને પણ પહેલાંથી જાણ ન હોય તેવી ખતરનાક સાઇટ વિશે તમને ચેતવણી આપે છે. તમે Thorium ચેતવણીઓને છોડી દેવાનું પસંદ કરી શકો છો.</translation>
<translation id="8182056223343645142">Thoriumમાંથી સાઇન આઉટ કરો</translation>
<translation id="4860412983011031251">Thorium સાથે સહાય મેળવો</translation>
<translation id="6079265919870015811">Thorium પ્રોફાઇલ ઉમેરો</translation>
<translation id="7473833913849364138">Thorium દ્વારા પેજ પહેલેથી લોડ કરવામાં આવે છે, જેને કારણે બ્રાઉઝ કરવાની અને શોધવાની ક્રિયા વધુ ઝડપી બને છે. <ph name="BEGIN_LINK" />પહેલેથી લોડ કરેલા પેજ વિશે વધુ જાણો<ph name="END_LINK" /></translation>
<translation id="898934820356659708">જો તમે Thoriumના વપરાશના રિપોર્ટ પણ શેર કરતા હો, તો તે રિપોર્ટમાં તમે મુલાકાત લો છો તે URLs શામેલ હોય છે</translation>
<translation id="9072534646955460921">Thorium પ્રોફાઇલ વડે, તમે તમારી બધી વસ્તુઓ Thorium પર અલગ-અલગ રાખી શકો છો. મિત્રો અને કુટુંબ માટે પ્રોફાઇલ બનાવો અથવા તેને ઑફિસ અને મનોરંજન વચ્ચે વિભાજિત કરો.</translation>
<translation id="4308905027810063387">Thoriumમાંથી સાઇન આઉટ કરો</translation>
<translation id="6312135329022974196">અન્ય Thorium પ્રોફાઇલ</translation>
<translation id="8828163608353368128">Thoriumમાં સાઇન-ઇનની મંજૂરી આપો</translation>
<translation id="6497325017313227277">Thorium માંથી દૂર કરો</translation>
<translation id="8315496929814159292">Thoriumને તમારા ડિફૉલ્ટ બ્રાઉઝર તરીકે સેટ કરો</translation>
<translation id="438883585792992435">નિષ્ક્રિય ટૅબમાંની મેમરી Thorium દ્વારા ઉપયોગમાં લેવામાં આવે છે. આને કારણે Thorium ટૅબ અને અન્ય ઍપને કમ્પ્યૂટરના વધુ સંસાધનો ફાળવીને પોતાને ઝડપી રાખી શકે છે. જ્યારે તમે તમારા નિષ્ક્રિય ટૅબ પર પાછા ફરો, ત્યારે તે ફરીથી ઑટોમૅટિક રીતે સક્રિય થાય છે. <ph name="BEGIN_LINK" />મેમરી સેવર વિશે વધુ જાણો<ph name="END_LINK" /></translation>
<translation id="1318664233874758685">Thorium નિયમિત રીતે ચેક કરીને એ વાતની ખાતરી કરતું રહે છે કે તમારા બ્રાઉઝરના સેટિંગ સૌથી સલામત છે. જો કોઈ બાબતનો રિવ્યૂ કરવો જરૂરી હશે તો અમે તમને તેની જાણ કરીશું.</translation>
<translation id="4212981493728012253">તમારા ડેટાને સુરક્ષિત કરવા માટે, Thoriumને તમે તાજેતરમાં મુલાકાત લીધી ન હોય તેવી સાઇટમાંથી પરવાનગીઓ દૂર કરવા દો. નોટિફિકેશન બંધ કરવામાં આવશે નહીં.</translation>
<translation id="3224040524634124542">જો તમે કુકીને મંજૂરી આપો, તો Thorium પહેલેથી લોડ કરતી વખતે તેનો ઉપયોગ કરી શકે છે</translation>
<translation id="1967056554017864811">તમારી Thorium પ્રોફાઇલને કસ્ટમાઇઝ કરો</translation>
<translation id="682714496634566410">તમારી Thorium પ્રોફાઇલને નામ આપો</translation>
<translation id="1927215335595997320">તમે જે પેજની મુલાકાત લેશો તેવી શક્યતા હોય, Thorium તેવા વધુ પેજને પણ પહેલેથી લોડ કરે છે, જેથી જ્યારે તમે તેમની મુલાકાત લો, ત્યારે તે વધુ ઝડપથી લોડ થાય</translation>
<translation id="4344849281720725205">જો તમે બુકમાર્કને તમારા Google એકાઉન્ટમાં પણ સાચવશો, તો તમે પ્રોડક્ટની કિંમતો Thoriumમાં ટ્રૅક કરી શકશો તેમજ જ્યારે પણ કિંમતમાં ઘટાડો થાય ત્યારે નોટિફિકેશન મેળવશો</translation>
<translation id="2905944704289173754">તમારા બધા ડિવાઇસ પર Thoriumને સિંક કરો અને મનગમતું બનાવો</translation>
<translation id="7023976647734322618">તમારા ઇન્ટરનેટ ટ્રાફિકનો ઍક્સેસ ધરાવતા લોકો માટે, તમે કઈ સાઇટની મુલાકાત લો છો તે જોવાનું વધુ મુશ્કેલ બનાવો. Thorium દ્વારા DNS (ડોમેન નેમ સિસ્ટમ)માં સાઇટનું IP ઍડ્રેસ જોવા માટે સુરક્ષિત કનેક્શનનો ઉપયોગ કરવામાં આવે છે.</translation>
<translation id="3124765553592510724">જ્યારે તમે ઍડ્રેસ બાર અથવા શોધ બૉક્સમાં ટાઇપ કરો છો, ત્યારે બહેતર સૂચનો મેળવવા માટે Thorium તમે જે ટાઇપ કરો છો તેને તમારા ડિફૉલ્ટ શોધ એન્જિનને મોકલે છે. આ સુવિધા છૂપા મોડમાં કામ કરતી નથી.</translation>
<translation id="5501994443630499490">Thoriumના JavaScript અને WebAssembly એન્જિનમાં વધારાની સુરક્ષા ચાલુ કરો</translation>
<translation id="3597078885567529815">અસુરક્ષિત સાઇટ અને ડાઉનલોડ વિશે <ph name="BEGIN_LINK" />Thorium તમને ચેતવણી આપે છે<ph name="END_LINK" /></translation>
<translation id="6539171476340543682">જ્યારે તમે તમારા પાસવર્ડ સાચવો ત્યારે Thorium તેને ચેક કરી શકે છે</translation>
<translation id="5422284534340886571">Thorium પ્રોફાઇલ ઉમેરો</translation>
<translation id="5346310914638900016">Thorium પ્રોફાઇલ મેનેજ કરો</translation>
<translation id="2601544977861663592">Thorium માં સાઇન ઇન કરો</translation>
<translation id="4933700843989736491">જ્યારે તમે Googleની અન્ય સેવાઓમાં સાઇન ઇન કરશો, ત્યારે Thoriumમાં સાઇન ઇન કરો</translation>
<translation id="7886351526956375471">કોણ Thoriumનો ઉપયોગ કરે છે?</translation>
<translation id="6618835206810857815">કૉપિરાઇટ <ph name="YEAR" /> Alex313031. બધા હક્કો સુરક્ષિત.</translation>
