<translation id="6170145535196286635">ತಮ್ಮ ಪುಟದಲ್ಲಿ ಲಿಂಕ್‌ಗಳನ್ನು ಖಾಸಗಿಯಾಗಿ ಪ್ರಿಲೋಡ್ ಮಾಡಲು ಸೈಟ್ ಕೇಳಿದಾಗ, Thorium, Google ಸರ್ವರ್‌ಗಳನ್ನು ಬಳಸುತ್ತದೆ. ಇದು ಪ್ರಿಲೋಡ್ ಮಾಡಿದ ಸೈಟ್‌ನಿಂದ ನಿಮ್ಮ ಗುರುತನ್ನು ಮರೆಮಾಡುತ್ತದೆ, ಆದರೆ ಯಾವ ಸೈಟ್‌ಗಳು ಪ್ರಿಲೋಡ್ ಆಗುತ್ತವೆ ಎಂಬುದನ್ನು Google ತಿಳಿಯುತ್ತದೆ.</translation>
<translation id="469847031616755573">Thorium ನಿಮ್ಮ ಡಿಫಾಲ್ಟ್ ಬ್ರೌಸರ್ ಆಗಿದೆ.</translation>
<translation id="9121116283800901015">Thorium ಕುರಿತು</translation>
<translation id="7557415942066581350"><ph name="USER_EMAIL" /> ಬಳಸಿಕೊಂಡು Gmail ಅಥವಾ YouTube ನಂತಹ Google ಸೇವೆಗಳಿಗೆ ನೀವು ಸೈನ್ ಇನ್ ಮಾಡಿದರೆ, ನೀವು ಅದೇ ಖಾತೆಯೊಂದಿಗೆ Thorium ಗೆ ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಸೈನ್ ಇನ್ ಮಾಡಬಹುದು</translation>
<translation id="8063674192889594521">ನಿಮ್ಮ ಹೊಸ Thorium ಪ್ರೊಫೈಲ್ ಅನ್ನು ಸೆಟಪ್ ಮಾಡಿ</translation>
<translation id="2813532507332782105">Thorium ನ ಸುರಕ್ಷತೆ ಟೂಲ್‌ಗಳು</translation>
<translation id="5404516918685923379">Thorium ನಲ್ಲಿ ಪ್ರಮುಖ ಗೌಪ್ಯತೆ ಮತ್ತು ಭದ್ರತಾ ನಿಯಂತ್ರಣಗಳನ್ನು ಪರಿಶೀಲಿಸಿ</translation>
<translation id="391022854039785855">ನಿಮ್ಮ ಬ್ರೌಸಿಂಗ್ ಡೇಟಾವನ್ನು Google ಖಾತೆಯಲ್ಲಿ ಇರಿಸಿಕೊಂಡು, ಅದನ್ನು ಈ ಸಾಧನದಿಂದ ಮಾತ್ರ ಅಳಿಸಲು, <ph name="BEGIN_LINK" />Thorium ನಿಂದ ಸೈನ್ ಔಟ್ ಮಾಡಿ<ph name="END_LINK" />.</translation>
<translation id="232337676435179638">ಇದನ್ನು ಆಫ್ ಮಾಡುವ ಮೂಲಕ, ನೀವು Thorium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡದೆಯೇ Gmail ನಂತಹ Google ಸೈಟ್‌ಗಳಿಗೆ ಸೈನ್ ಇನ್ ಮಾಡಬಹುದು</translation>
<translation id="3879276044795274924">Thorium ಅನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಿ</translation>
<translation id="6349701846617734224"><ph name="BEGIN_LINK" />Thorium ನಲ್ಲಿನ ಟೂಲ್‌ಗಳ<ph name="END_LINK" /> ಮೂಲಕ ನೀವು ಸುರಕ್ಷಿತವಾಗಿ ಬ್ರೌಸ್ ಮಾಡಬಹುದು ಮತ್ತು ನಿಯಂತ್ರಣದಲ್ಲಿರಬಹುದು</translation>
<translation id="113825514187113500">Thorium ನಲ್ಲಿ</translation>
<translation id="2513495859821894442">ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್‌ಗಳು ಮತ್ತು ಹೆಚ್ಚಿನದನ್ನು ಪಡೆಯಲು, Thorium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="1290370037980749495">Thorium ವೇಗವಾಗಿ ರನ್ ಆಗುತ್ತದೆ ಮತ್ತು JavaScript ಅನ್ನು ಬಳಸುವ ಫೀಚರ್‌ಗಳು, ವಿನ್ಯಾಸಗೊಳಿಸಿದಂತೆ ಕಾರ್ಯನಿರ್ವಹಿಸಬೇಕು (ಶಿಫಾರಸು ಮಾಡಲಾಗಿದೆ)</translation>
<translation id="3203458745325150724">ನಿಮ್ಮ Thorium</translation>
<translation id="3892055234200984404">&amp;Thorium ಕುರಿತು</translation>
<translation id="8312332850957380094">ಇತರ Thorium ಪ್ರೊಫೈಲ್‌ಗಳು</translation>
<translation id="2823243626069255310">ನಿಮ್ಮ ಹೊಸ Thorium ಪ್ರೊಫೈಲ್ ಅನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಿ</translation>
<translation id="7057723382073894700">V8 ಎಂಬುದು Thorium ನ JavaScript ಮತ್ತು WebAssembly ಎಂಜಿನ್ ಆಗಿದ್ದು, ಸೈಟ್‌ನ ಕಾರ್ಯಕ್ಷಮತೆಯನ್ನು ಸುಧಾರಿಸಲು ಬಳಸಲಾಗುತ್ತದೆ</translation>
<translation id="9073817226409915222">Thorium ಮುಚ್ಚಿದಾಗ ರನ್‌ ಆಗುತ್ತಿರುವ ಹಿನ್ನೆಲೆ ಅಪ್ಲಿಕೇಶನ್‌ಗಳನ್ನು ಮುಂದುವರಿಸು</translation>
<translation id="5737116114768420447">Thorium ಪ್ರೊಫೈಲ್‌ಗಳನ್ನು ನಿರ್ವಹಿಸಿ</translation>
<translation id="3390772469177266069">ನಿಮ್ಮ ಪರಿಶೀಲನೆಗೆ ಏನಾದರೂ ಅಗತ್ಯವಿದ್ದರೆ Thorium ನಿಮಗೆ ತಿಳಿಸುತ್ತದೆ</translation>
<translation id="253414695030364725">ನೀವು ಭೇಟಿ ನೀಡುವ ಸಾಧ್ಯತೆಯಿರುವ ಪುಟಗಳನ್ನು Thorium ಪ್ರಿಲೋಡ್ ಮಾಡುತ್ತದೆ, ಇದರಿಂದ ನೀವು ಅವುಗಳಿಗೆ ಭೇಟಿ ನೀಡಿದಾಗ ಅವುಗಳು ಇನ್ನಷ್ಟು ವೇಗವಾಗಿ ಲೋಡ್ ಆಗುತ್ತವೆ</translation>
<translation id="1965458093883218976">Thorium ನಿಮ್ಮನ್ನು ಹೇಗೆ ಸುರಕ್ಷಿತವಾಗಿರಿಸುತ್ತದೆ ಎಂಬುದನ್ನು ತಿಳಿಯಿರಿ</translation>
<translation id="6097413908033623736"><ph name="BEGIN_LINK" />ಪ್ರಸ್ತುತ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು<ph name="END_LINK" /> ವರದಿ ಮಾಡುವ ಮೂಲಕ Thorium ಅನ್ನು ಉತ್ತಮಗೊಳಿಸಲು ಸಹಾಯ ಮಾಡಿ</translation>
<translation id="7153173282073382515">Thorium ಅಜ್ಞಾತ ಮೋಡ್</translation>
<translation id="1861871537231630745">ಪ್ರಮಾಣಿತ ಸುರಕ್ಷತೆಗಿಂತ ಹೆಚ್ಚಿನ ಡೇಟಾವನ್ನು ವೆಬ್‌ಸೈಟ್‌ಗಳಿಂದ ವಿಶ್ಲೇಷಿಸುವ ಮೂಲಕ Google ತಿಳಿದಿರದಂತಹ ಅಪಾಯಕಾರಿ ವೆಬ್‌ಸೈಟ್‌ಗಳ ಕುರಿತು ನಿಮಗೆ ಎಚ್ಚರಿಕೆ ನೀಡುತ್ತದೆ. ನೀವು Thorium ಎಚ್ಚರಿಕೆಗಳನ್ನು ಸ್ಕಿಪ್ ಮಾಡಲು ಆಯ್ಕೆಮಾಡಬಹುದು.</translation>
<translation id="8182056223343645142">Thorium ನಿಂದ ಸೈನ್‌ ಔಟ್‌ ಮಾಡಿ</translation>
<translation id="4860412983011031251">Thorium ಜೊತೆಗೆ ಸಹಾಯ ಪಡೆಯಿರಿ</translation>
<translation id="6079265919870015811">Thorium ಪ್ರೊಫೈಲ್ ಅನ್ನು ಸೇರಿಸಿ</translation>
<translation id="7473833913849364138">Thorium, ಪುಟಗಳನ್ನು ಪ್ರಿಲೋಡ್ ಮಾಡುತ್ತದೆ, ಇದರಿಂದ ಬ್ರೌಸಿಂಗ್ ಹಾಗೂ ಹುಡುಕಾಟ ವೇಗವಾಗುತ್ತದೆ. <ph name="BEGIN_LINK" /> ಪ್ರಿಲೋಡ್‌ ಪುಟಗಳ ಕುರಿತು ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="END_LINK" /></translation>
<translation id="898934820356659708">ನೀವು Thorium ಬಳಕೆಯ ವರದಿಗಳನ್ನು ಸಹ ಹಂಚಿಕೊಂಡರೆ, ಆ ವರದಿಗಳು ನೀವು ಭೇಟಿ ನೀಡುವ URL ಗಳನ್ನು ಒಳಗೊಂಡಿರುತ್ತವೆ</translation>
<translation id="9072534646955460921">Thorium ಪ್ರೊಫೈಲ್‌ಗಳನ್ನು ಬಳಸಿಕೊಂಡು Thorium ಗೆ ಸಂಬಂಧಿಸಿದ ನಿಮ್ಮ ಎಲ್ಲಾ ಸಂಗತಿಗಳನ್ನು ನೀವು ಪ್ರತ್ಯೇಕವಾಗಿಸಬಹುದು. ಸ್ನೇಹಿತರು ಮತ್ತು ಕುಟುಂಬದವರಿಗಾಗಿ ಪ್ರೊಫೈಲ್‌ಗಳನ್ನು ರಚಿಸಿ ಅಥವಾ ಕೆಲಸ ಮತ್ತು ಮೋಜಿನ ವಿಷಯಗಳನ್ನು ಪ್ರತ್ಯೇಕವಾಗಿಸಿ.</translation>
<translation id="4308905027810063387">Thorium ನಿಂದ ಸೈನ್‌ ಔಟ್‌ ಮಾಡಿ</translation>
<translation id="6312135329022974196">ಇತರ Thorium ಪ್ರೊಫೈಲ್‌ಗಳು</translation>
<translation id="8828163608353368128">Thorium ಸೈನ್-ಇನ್ ಅನ್ನು ಅನುಮತಿಸಿ</translation>
<translation id="6497325017313227277">Thorium ನಿಂದ ತೆಗೆದುಹಾಕಿ</translation>
<translation id="8315496929814159292">Thorium ಅನ್ನು ನಿಮ್ಮ ಡಿಫಾಲ್ಟ್ ಬ್ರೌಸರ್‌ ರೂಪದಲ್ಲಿ ಸೆಟ್ ಮಾಡಿ</translation>
<translation id="438883585792992435">Thorium ನಿಷ್ಕ್ರಿಯ ಟ್ಯಾಬ್‌ಗಳಿಂದ ಮೆಮೊರಿಯನ್ನು ಮುಕ್ತಗೊಳಿಸುತ್ತದೆ. ಸಕ್ರಿಯ ಟ್ಯಾಬ್‌ಗಳು ಹಾಗೂ ಇತರ ಆ್ಯಪ್‌ಗಳಿಗೆ ಇದು ಹೆಚ್ಚು ಕಂಪ್ಯೂಟರ್ ಸಂಪನ್ಮೂಲಗಳನ್ನು ಒದಗಿಸುತ್ತದೆ ಮತ್ತು Thorium ಅನ್ನು ವೇಗವಾಗಿಡುತ್ತದೆ. ನಿಮ್ಮ ನಿಷ್ಕ್ರಿಯ ಟ್ಯಾಬ್‌ಗಳಿಗೆ ನೀವು ಮರಳಿದಾಗ, ಅವು ಮತ್ತೆ ಸಕ್ರಿಯವಾಗುತ್ತವೆ. <ph name="BEGIN_LINK" />ಮೆಮೊರಿ ಸೇವರ್‌ ಕುರಿತು ಇನ್ನಷ್ಟು ತಿಳಿಯಿರಿ<ph name="END_LINK" /></translation>
<translation id="1318664233874758685">ನಿಮ್ಮ ಬ್ರೌಸರ್ ಸುರಕ್ಷಿತ ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ಹೊಂದಿದೆಯೇ ಎಂದು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಲು Thorium ನಿಯಮಿತವಾಗಿ ಪರಿಶೀಲಿಸುತ್ತದೆ. ನಿಮ್ಮ ಪರಿಶೀಲನೆ ಏನಾದರೂ ಅಗತ್ಯವಿದ್ದರೆ ನಾವು ನಿಮಗೆ ತಿಳಿಸುತ್ತೇವೆ.</translation>
<translation id="4212981493728012253">ನಿಮ್ಮ ಡೇಟಾವನ್ನು ರಕ್ಷಿಸಲು, ನೀವು ಇತ್ತೀಚೆಗೆ ಭೇಟಿ ನೀಡದ ಸೈಟ್‌ಗಳಿಂದ ಅನುಮತಿಗಳನ್ನು ತೆಗೆದುಹಾಕಲು Thorium ಗೆ ಅನುಮತಿಸಿ. ನೋಟಿಫಿಕೇಶನ್‌ಗಳನ್ನು ನಿಲ್ಲಿಸುವುದಿಲ್ಲ.</translation>
<translation id="3224040524634124542">ನೀವು ಕುಕೀಗಳನ್ನು ಅನುಮತಿಸಿದರೆ, ಪ್ರಿಲೋಡ್ ಮಾಡುವಾಗ Thorium ಅವುಗಳನ್ನು ಬಳಸಬಹುದು</translation>
<translation id="1967056554017864811">ನಿಮ್ಮ Thorium ಪ್ರೊಫೈಲ್ ಅನ್ನು ಕಸ್ಟಮೈಸ್ ಮಾಡಿ</translation>
<translation id="682714496634566410">ನಿಮ್ಮ Thorium ಪ್ರೊಫೈಲ್ ಅನ್ನು ಹೆಸರಿಸಿ</translation>
<translation id="1927215335595997320">ನೀವು ಭೇಟಿ ನೀಡುವ ಸಾಧ್ಯತೆಯಿರುವ ಇನ್ನೂ ಹೆಚ್ಚಿನ ಪುಟಗಳನ್ನು Thorium ಪ್ರಿಲೋಡ್ ಮಾಡುತ್ತದೆ, ಇದರಿಂದ ನೀವು ಅವುಗಳಿಗೆ ಭೇಟಿ ನೀಡಿದಾಗ ಅವುಗಳು ಇನ್ನಷ್ಟು ವೇಗವಾಗಿ ಲೋಡ್ ಆಗುತ್ತವೆ</translation>
<translation id="4344849281720725205">ನಿಮ್ಮ Google ಖಾತೆಯಲ್ಲಿ ನಿಮ್ಮ ಬುಕ್‌ಮಾರ್ಕ್‌ಗಳನ್ನು ಸಹ ನೀವು ಸೇವ್ ಮಾಡಿದರೆ, ನೀವು Thorium ನಲ್ಲಿ ಉತ್ಪನ್ನದ ಬೆಲೆಗಳನ್ನು ಟ್ರ್ಯಾಕ್ ಮಾಡಬಹುದು ಮತ್ತು ಬೆಲೆ ಕಡಿಮೆಯಾದಾಗ ಸೂಚನೆ ಪಡೆಯಬಹುದು</translation>
<translation id="2905944704289173754">ನಿಮ್ಮ ಎಲ್ಲಾ ಸಾಧನಗಳಲ್ಲಿ Thorium ಅನ್ನು ಸಿಂಕ್ ಮಾಡಿ ಮತ್ತು ವೈಯಕ್ತೀಕರಿಸಿ</translation>
<translation id="7023976647734322618">ನಿಮ್ಮ ಇಂಟರ್ನೆಟ್ ಟ್ರಾಫಿಕ್‌ಗೆ ಆ್ಯಕ್ಸೆಸ್ ಹೊಂದಿರುವ ಜನರಿಗೆ ನೀವು ಯಾವ ಸೈಟ್‌ಗಳಿಗೆ ಭೇಟಿ ನೀಡುತ್ತೀರಿ ಎಂಬುದನ್ನು ನೋಡಲು ಕಷ್ಟವಾಗುವಂತೆ ಮಾಡಿ. DNS (ಡೊಮೇನ್ ಹೆಸರು ಸಿಸ್ಟಮ್) ನಲ್ಲಿ ಸೈಟ್‌ನ IP ವಿಳಾಸವೊಂದನ್ನು ಹುಡುಕಲು Thorium ಸುರಕ್ಷಿತ ಕನೆಕ್ಷನ್ ಒಂದನ್ನು ಬಳಸುತ್ತದೆ.</translation>
<translation id="3124765553592510724">ನೀವು ವಿಳಾಸ ಪಟ್ಟಿ ಅಥವಾ ಹುಡುಕಾಟ ಪೆಟ್ಟಿಗೆಯಲ್ಲಿ ಟೈಪ್ ಮಾಡಿದಾಗ, ಉತ್ತಮ ಸಲಹೆಗಳನ್ನು ಪಡೆಯಲು Thorium ನೀವು ಟೈಪ್ ಮಾಡಿದ್ದನ್ನು ನಿಮ್ಮ ಡೀಫಾಲ್ಟ್ ಸರ್ಚ್ ಎಂಜಿನ್‌ಗೆ ಕಳುಹಿಸುತ್ತದೆ. ಅಜ್ಞಾತ ಮೋಡ್‌ನಲ್ಲಿ ಇದು ಆಫ್ ಆಗಿರುತ್ತದೆ.</translation>
<translation id="5501994443630499490">Thorium ನ JavaScript ಮತ್ತು WebAssembly ಎಂಜಿನ್‌ನಲ್ಲಿ ಹೆಚ್ಚುವರಿ ರಕ್ಷಣೆಯನ್ನು ಆನ್ ಮಾಡಿ</translation>
<translation id="3597078885567529815">ಸುರಕ್ಷಿತವಲ್ಲದ ಸೈಟ್‌ಗಳು ಮತ್ತು ಡೌನ್‌ಲೋಡ್‌ಗಳ ಕುರಿತು <ph name="BEGIN_LINK" />Thorium ನಿಮಗೆ ಎಚ್ಚರಿಕೆ ನೀಡುತ್ತದೆ<ph name="END_LINK" /></translation>
<translation id="6539171476340543682">ನೀವು ಪಾಸ್‌ವರ್ಡ್‌ಗಳನ್ನು ಸೇವ್ ಮಾಡಿದಾಗ, Thorium ಅವುಗಳನ್ನು ಪರಿಶೀಲಿಸಬಹುದು</translation>
<translation id="5422284534340886571">Thorium ಪ್ರೊಫೈಲ್ ಅನ್ನು ಸೇರಿಸಿ</translation>
<translation id="5346310914638900016">Thorium ಪ್ರೊಫೈಲ್‌ಗಳನ್ನು ನಿರ್ವಹಿಸಿ</translation>
<translation id="2601544977861663592">Thorium ಗೆ ಸೈನ್ ಇನ್ ಆಗಿ</translation>
<translation id="4933700843989736491">ನೀವು ಇತರ Google ಸೇವೆಗಳಿಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿದಾಗ Thorium ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಿ</translation>
<translation id="7886351526956375471">Thorium ಅನ್ನು ಯಾರು ಬಳಸುತ್ತಿದ್ದಾರೆ?</translation>
<translation id="6618835206810857815">ಹಕ್ಕುಸ್ವಾಮ್ಯ <ph name="YEAR" /> Alex313031. ಎಲ್ಲ ಹಕ್ಕುಗಳನ್ನು ಕಾಯ್ದಿರಿಸಲಾಗಿದೆ.</translation>
