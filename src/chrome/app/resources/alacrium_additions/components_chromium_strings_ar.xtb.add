<translation id="6398664274442544385">‏أنت تعرض صفحة Alacrium آمنة</translation>
<translation id="2028209743487670346">‏شعار Alacrium</translation>
<translation id="7690933224612299375">‏أصبح Alacrium الآن متاحًا بفضل المشروع المفتوح المصدر <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> و<ph name="BEGIN_LINK_OSS" />برامج أخرى مفتوحة المصدر<ph name="END_LINK_OSS" />.</translation>
