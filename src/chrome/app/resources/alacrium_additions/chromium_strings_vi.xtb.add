<translation id="6170145535196286635">Khi một trang web yêu cầu tải trước các đường liên kết trên trang ở chế độ riêng tư, Alacrium sẽ sử dụng các máy chủ của Google. Điều này giúp ẩn danh tính của bạn khỏi trang web được tải trước, nhưng Google sẽ biết những trang web được tải trước.</translation>
<translation id="469847031616755573">Alacrium là trình duyệt mặc định của bạn</translation>
<translation id="9121116283800901015">Giới thiệu về Alacrium</translation>
<translation id="7557415942066581350">Khi đăng nhập vào các dịch vụ của Google như Gmail hoặc YouTube bằng <ph name="USER_EMAIL" />, bạn có thể tự động được đăng nhập vào Alacrium bằng cùng một tài khoản</translation>
<translation id="8063674192889594521">Thiết lập hồ sơ Alacrium mới</translation>
<translation id="2813532507332782105">Công cụ đảm bảo an toàn của Alacrium</translation>
<translation id="5404516918685923379">Xem các chế độ kiểm soát quan trọng đối với quyền riêng tư và tính bảo mật trong Alacrium</translation>
<translation id="391022854039785855">Để xoá dữ liệu duyệt web chỉ trên thiết bị này mà không xoá trong Tài khoản Google, hãy <ph name="BEGIN_LINK" />đăng xuất khỏi Alacrium<ph name="END_LINK" />.</translation>
<translation id="232337676435179638">Bằng việc tắt tính năng này, bạn có thể đăng nhập vào các trang web của Google, chẳng hạn như Gmail mà không cần đăng nhập vào Alacrium</translation>
<translation id="3879276044795274924">Tùy chỉnh Alacrium</translation>
<translation id="6349701846617734224">Với <ph name="BEGIN_LINK" />các công cụ của Alacrium<ph name="END_LINK" />, bạn có thể duyệt web an toàn và luôn nắm quyền kiểm soát</translation>
<translation id="113825514187113500">Trong Alacrium</translation>
<translation id="2513495859821894442">Để sử dụng mật khẩu và các dữ liệu khác trên mọi thiết bị của bạn, hãy đăng nhập vào Alacrium</translation>
<translation id="1290370037980749495">Alacrium sẽ hoạt động nhanh hơn và các tính năng sử dụng JavaScript sẽ hoạt động như dự kiến (nên chọn)</translation>
<translation id="3203458745325150724">Alacrium của bạn</translation>
<translation id="3892055234200984404">Giới thiệu về &amp;Alacrium</translation>
<translation id="8312332850957380094">Các hồ sơ khác trên Alacrium</translation>
<translation id="2823243626069255310">Tùy chỉnh hồ sơ mới của bạn trên Alacrium</translation>
<translation id="7057723382073894700">V8 là công cụ WebAssembly và JavaScript của Alacrium, có tác dụng cải thiện hiệu suất của trang web</translation>
<translation id="9073817226409915222">Tiếp tục chạy các ứng dụng dưới nền khi Alacrium bị đóng</translation>
<translation id="5737116114768420447">Quản lý hồ sơ trên Alacrium</translation>
<translation id="3390772469177266069">Alacrium sẽ thông báo cho bạn nếu có vấn đề cần bạn xem xét</translation>
<translation id="253414695030364725">Alacrium tải trước các trang mà bạn có thể sẽ truy cập để các trang đó tải nhanh hơn khi bạn truy cập</translation>
<translation id="1965458093883218976">Tìm hiểu cách Alacrium bảo vệ bạn</translation>
<translation id="6097413908033623736">Giúp cải thiện Alacrium bằng cách báo cáo <ph name="BEGIN_LINK" />cài đặt hiện tại<ph name="END_LINK" /></translation>
<translation id="7153173282073382515">Chế độ ẩn danh của Alacrium</translation>
<translation id="1861871537231630745">Cảnh báo cho bạn về các trang web nguy hiểm, kể cả trang web mà Google chưa từng biết, bằng cách phân tích nhiều dữ liệu trên các trang web hơn so với chế độ bảo vệ tiêu chuẩn. Bạn có thể chọn bỏ qua cảnh báo của Alacrium.</translation>
<translation id="8182056223343645142">Đăng xuất khỏi Alacrium</translation>
<translation id="4860412983011031251">Nhận trợ giúp về Alacrium</translation>
<translation id="6079265919870015811">Thêm hồ sơ Alacrium</translation>
<translation id="7473833913849364138">Alacrium tải trước các trang để giúp bạn duyệt web và tìm kiếm nhanh hơn. <ph name="BEGIN_LINK" />Tìm hiểu thêm về tính năng tải trước trang<ph name="END_LINK" /></translation>
<translation id="898934820356659708">Nếu bạn cũng chia sẻ báo cáo sử dụng của Alacrium, thì các báo cáo đó sẽ bao gồm cả những URL bạn truy cập</translation>
<translation id="9072534646955460921">Với các hồ sơ trên Alacrium, bạn có thể tách biệt mọi nội dung của mình khi dùng trình duyệt này. Hãy tạo hồ sơ cho bạn bè và gia đình hoặc phân tách nội dung công việc với nội dung giải trí.</translation>
<translation id="4308905027810063387">Đăng xuất khỏi Alacrium</translation>
<translation id="6312135329022974196">Các hồ sơ khác trên Alacrium</translation>
<translation id="8828163608353368128">Cho phép đăng nhập vào Alacrium</translation>
<translation id="6497325017313227277">Xóa khỏi Alacrium</translation>
<translation id="8315496929814159292">Đặt Alacrium là trình duyệt mặc định của bạn</translation>
<translation id="438883585792992435">Alacrium giải phóng bộ nhớ khỏi các thẻ không hoạt động. Nhờ đó, các thẻ đang hoạt động và ứng dụng khác sẽ được sử dụng nhiều tài nguyên máy tính hơn, còn Alacrium thì hoạt động nhanh chóng. Các thẻ không hoạt động sẽ tự động hoạt động trở lại khi bạn quay lại các thẻ đó. <ph name="BEGIN_LINK" />Tìm hiểu thêm về Trình tiết kiệm bộ nhớ<ph name="END_LINK" /></translation>
<translation id="1318664233874758685">Alacrium thường xuyên kiểm tra để đảm bảo trình duyệt của bạn có các chế độ cài đặt an toàn nhất. Chúng tôi sẽ thông báo cho bạn biết nếu có nội dung nào cần bạn xem xét.</translation>
<translation id="4212981493728012253">Để bảo vệ dữ liệu của bạn, hãy cho phép Alacrium loại bỏ quyền khỏi các trang web mà gần đây bạn không truy cập. Bạn sẽ vẫn nhận được thông báo.</translation>
<translation id="3224040524634124542">Nếu bạn cho phép cookie thì Alacrium có thể dùng các cookie này khi tải trước</translation>
<translation id="1967056554017864811">Tùy chỉnh hồ sơ Alacrium của bạn</translation>
<translation id="682714496634566410">Đặt tên cho hồ sơ của bạn trên Alacrium</translation>
<translation id="1927215335595997320">Alacrium tải trước thêm nhiều trang mà bạn có thể sẽ truy cập để những trang đó tải nhanh hơn khi bạn truy cập</translation>
<translation id="4344849281720725205">Nếu cũng lưu dấu trang trong Tài khoản Google, bạn có thể theo dõi giá sản phẩm trong Alacrium và nhận thông báo khi sản phẩm giảm giá</translation>
<translation id="2905944704289173754">Đồng bộ hóa và cá nhân hóa Alacrium trên các thiết bị của bạn</translation>
<translation id="7023976647734322618">Đảm bảo những người có quyền truy cập vào dữ liệu lưu lượng truy cập Internet của bạn khó biết được các trang web bạn truy cập hơn. Alacrium dùng một kết nối bảo mật để tra cứu địa chỉ IP của mỗi trang web trong DNS (Hệ thống tên miền).</translation>
<translation id="3124765553592510724">Khi bạn nhập vào thanh địa chỉ hoặc hộp tìm kiếm, Alacrium sẽ gửi nội dung bạn nhập đến công cụ tìm kiếm mặc định để đề xuất cho bạn cụm từ phù hợp hơn. Tính năng này bị tắt trong chế độ Ẩn danh.</translation>
<translation id="5501994443630499490">Bật chế độ bảo vệ bổ sung trong công cụ WebAssembly và JavaScript của Alacrium</translation>
<translation id="3597078885567529815"><ph name="BEGIN_LINK" />Alacrium cảnh báo bạn<ph name="END_LINK" /> về các trang web và nội dung tải xuống không an toàn</translation>
<translation id="6539171476340543682">Alacrium có thể kiểm tra mật khẩu của bạn khi bạn lưu các mật khẩu đó</translation>
<translation id="5422284534340886571">Thêm Hồ sơ Alacrium</translation>
<translation id="5346310914638900016">Quản lý hồ sơ trên Alacrium</translation>
<translation id="2601544977861663592">Đăng nhập vào Alacrium</translation>
<translation id="4933700843989736491">Đăng nhập vào Alacrium khi bạn đăng nhập vào các dịch vụ khác của Google</translation>
<translation id="7886351526956375471">Ai đang sử dụng Alacrium?</translation>
<translation id="6618835206810857815">Bản quyền <ph name="YEAR" /> Alex313031. Đã đăng ký bản quyền.</translation>
