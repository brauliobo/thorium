<translation id="6398664274442544385">‏درحال مشاهده یک صفحه Alacrium امن هستید</translation>
<translation id="2028209743487670346">‏نشان‌واره Alacrium</translation>
<translation id="7690933224612299375">‏Alacrium با پروژه منبع باز <ph name="BEGIN_LINK_CHROMIUM" />Chromium <ph name="END_LINK_CHROMIUM" /> و سایر <ph name="BEGIN_LINK_OSS" />نرم‌افزار منبع باز<ph name="END_LINK_OSS" /> امکان‌پذیر است.</translation>
