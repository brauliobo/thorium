<translation id="6170145535196286635">‏جب کوئی سائٹ اپنے صفحے پر لنکس کو نجی طور پر پیشگی لوڈ کرنے کا مطالبہ کرتی ہے تو Alacrium براؤزر ‏Google سرورز کا استعمال کرتا ہے۔ اس سے پیشگی لوڈ کردہ سائٹ سے آپ کی شناخت پوشیدہ ہو جاتی ہے، لیکن Google جانتا ہے کہ کونسی سائٹس پیشگی لوڈ ہوتی ہیں۔</translation>
<translation id="469847031616755573">‏Alacrium آپ کا ڈیفالٹ براؤزر ہے</translation>
<translation id="9121116283800901015">‏Alacrium کے بارے میں</translation>
<translation id="7557415942066581350">‏<ph name="USER_EMAIL" /> کے ساتھ Gmail یا YouTube جیسی Google سروسز میں سائن ان کرتے وقت، آپ اسی اکاؤنٹ سے خودکار طور پر Alacrium میں سائن ان کر سکتے ہیں</translation>
<translation id="8063674192889594521">‏اپنی نئی Alacrium پروفائل سیٹ اپ کریں</translation>
<translation id="2813532507332782105">‏Alacrium کے سیفٹی ٹولز</translation>
<translation id="5404516918685923379">‏Alacrium میں کلیدی رازداری اور سیکیورٹی کنٹرولز کا جائزہ لیں</translation>
<translation id="391022854039785855">‏براؤزنگ ڈیٹا کو اپنے Google اکاؤنٹ میں برقرار رکھتے ہوئے، صرف اس آلہ سے اسے حذف کرنے کیلئے، <ph name="BEGIN_LINK" />Alacrium سے سائن آؤٹ کریں<ph name="END_LINK" />۔</translation>
<translation id="232337676435179638">‏اسے آف کر کے، آپ Alacrium میں سائن ان کیے بغیر Gmail جیسی Google سائٹس میں سائن ان کر سکتے ہیں</translation>
<translation id="3879276044795274924">‏Alacrium کو حسب ضرورت بنائیں</translation>
<translation id="6349701846617734224">‏<ph name="BEGIN_LINK" />Alacrium کے ٹولز<ph name="END_LINK" /> کے ذریعے آپ محفوظ طریقے سے براؤز کر سکتے ہیں اور چیزوں پر کنٹرول رکھ سکتے ہیں</translation>
<translation id="113825514187113500">‏Alacrium میں</translation>
<translation id="2513495859821894442">‏اپنے تمام آلات پر اپنے پاس ورڈز وغیرہ حاصل کرنے کے لیے، Alacrium میں سائن ان کریں</translation>
<translation id="1290370037980749495">‏Alacrium تیزی سے چلتا ہے اور JavaScript استعمال کرنے والی خصوصیات کو ڈیزائن کے مطابق کام کرنا چاہیے (تجویز کردہ)</translation>
<translation id="3203458745325150724">‏آپ کا Alacrium</translation>
<translation id="3892055234200984404">‏Alacrium&amp; کے بارے میں</translation>
<translation id="8312332850957380094">‏دیگر Alacrium پروفائلز</translation>
<translation id="2823243626069255310">‏اپنی نئی Alacrium پروفائل کو حسب ضرورت بنائیں</translation>
<translation id="7057723382073894700">‏V8‏ Alacrium کا JavaScript اور WebAssembly انجن ہے جو سائٹ کی کارکردگی کو بہتر بنانے کے لیے استعمال ہوتا ہے</translation>
<translation id="9073817226409915222">‏Alacrium بند ہو جانے پر پس منظر کی ایپس چلانا جاری رکھیں</translation>
<translation id="5737116114768420447">‏Alacrium پروفائلز کا نظم کریں</translation>
<translation id="3390772469177266069">‏اگر کسی چیز کو آپ کے جائزے کی ضرورت ہے تو Alacrium آپ کو مطلع کرے گا</translation>
<translation id="253414695030364725">‏Alacrium ان صفحات کو پیشگی لوڈ کرتا ہے جنہیں آپ ممکنہ طور پر ملاحظہ کر سکتے ہیں، تاکہ وہ آپ کے ملاحظہ کرتے وقت مزید تیزی سے لوڈ ہو سکیں</translation>
<translation id="1965458093883218976">‏جانیں کہ Alacrium آپ کو کیسے محفوظ رکھتا ہے</translation>
<translation id="6097413908033623736">‏<ph name="BEGIN_LINK" />موجودہ ترتیبات<ph name="END_LINK" /> کی اطلاع دے کر Alacrium کو بہتر بنانے میں مدد کریں</translation>
<translation id="7153173282073382515">‏Alacrium پوشیدگی</translation>
<translation id="1861871537231630745">‏معیاری تحفظ سے زیادہ سائٹس کے ڈیٹا کا تجزیہ کر کے، آپ کو خطرناک سائٹس، یہاں تک کہ جن کے بارے میں Google پہلے نہیں جانتا تھا، کے بارے میں خبردار کرتا ہے۔ آپ Alacrium وارننگز کو نظر انداز کرنے کا انتخاب کر سکتے ہیں۔</translation>
<translation id="8182056223343645142">‏‫Alacrium سے سائن آؤٹ کریں</translation>
<translation id="4860412983011031251">‏Alacrium کے بارے میں مدد حاصل کریں</translation>
<translation id="6079265919870015811">‏‫Alacrium پروفائل شامل کریں</translation>
<translation id="7473833913849364138">‏‫Alacrium صفحات کو پہلے سے لوڈ کرتا ہے جس براؤزنگ اور تلاش کا عمل زیادہ تیز ہو جاتا ہے۔ <ph name="BEGIN_LINK" />پیشگی لوڈ کے صفحات کے بارے میں مزید جانیں<ph name="END_LINK" /></translation>
<translation id="898934820356659708">‏اگر آپ Alacrium کے استعمال کی رپورٹس کا بھی اشتراک کرتے ہیں تو ان رپورٹس میں آپ کے ملاحظہ کردہ URLs شامل ہوں گے</translation>
<translation id="9072534646955460921">‏‫Alacrium کی پروفائلز کی مدد سے، آپ Alacrium کی اپنی سبھی چیزوں کو الگ کر سکتے ہیں۔ دوستوں اور فیملی کیلئے پروفائلز تخلیق کریں یا کام اور تفریح کو الگ کریں۔</translation>
<translation id="4308905027810063387">‏Alacrium سے سائن آؤٹ کریں</translation>
<translation id="6312135329022974196">‏دیگر Alacrium پروفائلز</translation>
<translation id="8828163608353368128">‏Alacrium میں سائن ان کی اجازت دیں</translation>
<translation id="6497325017313227277">‏Alacrium سے ہٹائیں</translation>
<translation id="8315496929814159292">‏Alacrium کو اپنے ڈیفالٹ براؤزر کے بطور سیٹ کریں</translation>
<translation id="438883585792992435">‏‫Alacrium غیر فعال ٹیبز سے میموری کو خالی کرتا ہے۔ یہ فعال ٹیبز اور دیگر ایپس کو کمپیوٹر کے مزید وسائل فراہم کرتا ہے اور Alacrium کو تیز رکھتا ہے۔ جب آپ ان پر واپس جاتے ہیں تو آپ کے غیر فعال ٹیبز خودکار طور پر دوبارہ فعال ہو جاتے ہیں۔ <ph name="BEGIN_LINK" />میموری سیور کے بارے میں مزید جانیں<ph name="END_LINK" /></translation>
<translation id="1318664233874758685">‏Alacrium باقاعدگی سے یہ یقینی بنانے کے لیے چیک کرتا ہے کہ آپ کے براؤزر میں سب سے محفوظ ترتیبات موجود ہیں۔ اگر کسی چیز کو آپ کے جائزے کی ضرورت ہے تو ہم آپ کو مطلع کریں گے۔</translation>
<translation id="4212981493728012253">‏اپنے ڈیٹا کی تحفظ کے لیے، Alacrium کو ان سائٹس سے اجازتیں ہٹانے کی اجازت دیں جن پر آپ حال ہی میں نہیں گئے ہیں۔ اس سے اطلاعات بند نہیں ہوتی ہیں۔</translation>
<translation id="3224040524634124542">‏اگر آپ کوکیز کی اجازت دیتے ہیں تو Alacrium پیشگی لوڈنگ کے دوران ان کا استعمال کر سکتا ہے</translation>
<translation id="1967056554017864811">‏اپنی Alacrium پروفائل کو حسب ضرورت بنائیں</translation>
<translation id="682714496634566410">‏اپنی Alacrium پروفائل کو نام دیں</translation>
<translation id="1927215335595997320">‏Alacrium ایسے اور بھی مزید صفحات کو پیشگی لوڈ کرتا ہے جنہیں آپ ممکنہ طور پر ملاحظہ کر سکتے ہیں، تاکہ وہ آپ کے ملاحظہ کرتے وقت مزید تیزی سے لوڈ ہو سکیں</translation>
<translation id="4344849281720725205">‏اگر آپ اپنے بُک مارکس کو اپنے Google اکاؤنٹ میں بھی محفوظ کرتے ہیں تو آپ Alacrium میں پروڈکٹ کی قیمتوں کو ٹریک کر سکتے ہیں اور قیمت میں گراوٹ ہونے پر اطلاع حاصل کر سکتے ہیں</translation>
<translation id="2905944704289173754">‏اپنے آلات پر Alacrium کو مطابقت پذیر اور ذاتی نوعیت کا بنائیں</translation>
<translation id="7023976647734322618">‏آپ کے انٹرنیٹ ٹریفک تک رسائی والے لوگوں کے لیے یہ دیکھنا مشکل بنائیں کہ آپ کون سی سائٹس ملاحظہ کرتے ہیں۔ Alacrium DNS (ڈومین ناموں کے نظم) میں سائٹ کا IP پتہ تلاش کرنے کے لیے ایک محفوظ کنکشن کا استعمال کرتا ہے۔</translation>
<translation id="3124765553592510724">‏جب آپ ایڈریس بار یا تلاش کے خانے میں ٹائپ کرتے ہیں تو بہتر تجاویز حاصل کرنے کے لیے Alacrium آپ جو ٹائپ کرتے ہیں اسے آپ کے ڈیفالٹ سرچ انجن کو بھیجتا ہے۔ یہ پوشیدگی میں آف ہے۔</translation>
<translation id="5501994443630499490">‏Alacrium کے JavaScript اور WebAssembly انجن میں اضافی تحفظ آن کریں</translation>
