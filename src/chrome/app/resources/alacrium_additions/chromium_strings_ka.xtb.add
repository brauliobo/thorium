<translation id="6170145535196286635">როცა საიტი გთხოვთ, უფლება მისცეთ, კონფიდენციალურად ჩატვირთოს თავის გვერდზე არსებული ბმულები, Alacrium გამოიყენებს Google-ის სერვერებს. აღნიშნული დამალავს თქვენს ვინაობას წინასწარ ჩატვირთული საიტისგან, თუმცა Google-ს ეცოდინება, რომელი საიტები იტვირთება წინასწარ.</translation>
<translation id="469847031616755573">Alacrium თქვენი ნაგულისხმევი ბრაუზერია</translation>
<translation id="9121116283800901015">Alacrium-ის შესახებ</translation>
<translation id="7557415942066581350">Google სერვისებში, მაგალითად, Gmail-სა თუ YouTube-ში <ph name="USER_EMAIL" />-ით შესვლისას შეგიძლიათ Alacrium-შიც იმავე ანგარიშით შეხვიდეთ</translation>
<translation id="8063674192889594521">შექმენით ახალი Alacrium პროფილი</translation>
<translation id="2813532507332782105">Alacrium-ის უსაფრთხოების ხელსაწყოები</translation>
<translation id="5404516918685923379">გადახედეთ კონფიდენციალურობისა და უსაფრთხოების მართვის საკვანძო საშუალებებს Alacrium-ში</translation>
<translation id="391022854039785855">დათვალიერების მონაცემების მხოლოდ ამ მოწყობილობიდან წასაშლელად და Google ანგარიშში მათ შესანარჩუნებლად <ph name="BEGIN_LINK" />გამოდით Alacrium-იდან<ph name="END_LINK" />.</translation>
<translation id="232337676435179638">ამ პარამეტრის გამორთვის შემთხვევაში, Google-ის საიტებში (მაგალითად, Gmail-ში) შესვლას შეძლებთ Alacrium-ში შესვლის გარეშე</translation>
<translation id="3879276044795274924">Alacrium-ის მორგება</translation>
<translation id="6349701846617734224"><ph name="BEGIN_LINK" />Alacrium-ში არსებული ხელსაწყოები<ph name="END_LINK" /> დაგეხმარებათ, უსაფრთხოდ დაათვალიეროთ ვები და შეინარჩუნოთ კონტროლი</translation>
<translation id="113825514187113500">Alacrium-ში</translation>
<translation id="2513495859821894442">თქვენს ყველა მოწყობილობაზე პაროლებისა და სხვა კონტენტის მისაღებად შედით Alacrium-ში</translation>
<translation id="1290370037980749495">Alacrium უფრო სწრაფად, ხოლო ფუნქციები, რომლებიც JavaScript-ს იყენებს, დანიშნულებისამებრ იმუშავებს (რეკომენდებული)</translation>
<translation id="3203458745325150724">თქვენი Alacrium</translation>
<translation id="3892055234200984404">Alacrium-ის შ&amp;ესახებ</translation>
<translation id="8312332850957380094">სხვა Alacrium პროფილები</translation>
<translation id="2823243626069255310">მოირგეთ თქვენი ახალი Alacrium პროფილი</translation>
<translation id="7057723382073894700">V8 არის Alacrium-ის JavaScript-ისა და WebAssembly-ს ძრავა, რომელიც საიტების წარმადობის გასაუმჯობესებლად გამოიყენება</translation>
<translation id="9073817226409915222">ფონური პროგრამების გაშვების გაგრძელება, როდესაც Alacrium იხურება</translation>
<translation id="5737116114768420447">Alacrium-ის პროფილების მართვა</translation>
<translation id="3390772469177266069">Alacrium გაცნობებთ, თუ რაიმეს შემოწმება დაგჭირდებათ</translation>
<translation id="253414695030364725">Alacrium წინასწარ ჩატვირთავს გვერდებს, რომელთა ნახვასაც, სავარაუდოდ, დააპირებთ — ამგვარად, ამ გვერდებზე გადასვლისას, ისინი უფრო სწრაფად ჩაიტვირთება</translation>
<translation id="1965458093883218976">შეიტყვეთ, როგორ ზრუნავს Alacrium თქვენს უსაფრთხოებაზე</translation>
<translation id="6097413908033623736">ხელი შეუწყვეთ Alacrium-ის გაუმჯობესებას <ph name="BEGIN_LINK" />მიმდინარე პარამეტრების<ph name="END_LINK" /> გამოგზავნის მეშვეობით</translation>
<translation id="7153173282073382515">Alacrium-ის ინკოგნიტო რეჟიმი</translation>
<translation id="1861871537231630745">გაგაფრთხილებთ სახიფათო საიტების შესახებ (თუნდაც Google-ისთვის იქამდე უცნობის შესახებ) საიტებიდან იმაზე მეტი მონაცემის სკანირების მეშვეობით, ვიდრე სტანდარტული დაცვის შემთხვევაში. სურვილისამებრ, შეგიძლიათ გამოტოვოთ Alacrium-ის გაფრთხილებები.</translation>
<translation id="8182056223343645142">Alacrium-იდან გასვლა</translation>
<translation id="4860412983011031251">Alacrium-თან დაკავშირებული დახმარების მიღება</translation>
<translation id="6079265919870015811">Alacrium პროფილის დამატება</translation>
<translation id="7473833913849364138">Alacrium წინასწარ ჩატვირთავს გვერდებს, რაც დააჩქარებს დათვალიერებას და ძიებას. <ph name="BEGIN_LINK" />შეიტყვეთ მეტი წინასწარ ჩატვირთული გვერდების შესახებ<ph name="END_LINK" /></translation>
<translation id="898934820356659708">თუ Alacrium-ის მოხმარების ანგარიშებსაც გააზიარებთ, მათ თქვენ მიერ მონახულებულ URL-ებიც დაერთვება</translation>
<translation id="9072534646955460921">Alacrium პროფილები Alacrium-ში არსებული თქვენი კონტენტის განცალკევების საშუალებას გაძლევთ. შექმენით პროფილები ოჯახის წევრებისა და მეგობრებისთვის, ან განაცალკევეთ სამსახურებრივი და პირადი მონაცემები.</translation>
<translation id="4308905027810063387">Alacrium-იდან გამოსვლა</translation>
<translation id="6312135329022974196">სხვა Alacrium პროფილები</translation>
<translation id="8828163608353368128">Alacrium-ში შესვლის დაშვება</translation>
<translation id="6497325017313227277">Alacrium-იდან ამოღება</translation>
<translation id="8315496929814159292">დააყენეთ Alacrium ნაგულისხმევ ბრაუზერად</translation>
<translation id="438883585792992435">Alacrium გაასუფთავებს მეხსიერებას უმოქმედო ჩანართებიდან. აქტიურ ჩანართებსა და სხვა აპებს კომპიუტერის მეტი რესურსის გამოყენების საშუალება მიეცემა, რაც დააჩქარებს Alacrium-საც. თქვენი არააქტიური ჩანართები ავტომატურად გააქტიურდება, როცა მათ დაუბრუნდებით. <ph name="BEGIN_LINK" />შეიტყვეთ მეტი მეხსიერების დამზოგის შესახებ<ph name="END_LINK" /></translation>
<translation id="1318664233874758685">Alacrium რეგულარულად ამოწმებს, არის თუ არა თქვენს ბრაუზერში ყველაზე უსაფრთხო პარამეტრები. გაცნობებთ, თუ რაიმეს შემოწმება იქნება საჭირო.</translation>
<translation id="4212981493728012253">თქვენი მონაცემების დაცვის მიზნით, მიეცით საშუალება Alacrium-ს გააუქმოს ნებართვები საიტებს, რომლებზეც ბოლო დროს არ გადასულხართ. აღნიშნული არ გათიშავს შეტყობინებების მიღების ფუნქციას.</translation>
<translation id="3224040524634124542">ქუქი-ჩანაწერების დაშვების შემთხვევაში, Alacrium-მა, შესაძლოა, გამოიყენოს ისინი წინასწარ ჩატვირთვისთვის</translation>
<translation id="1967056554017864811">თქვენი Alacrium პროფილის მორგება</translation>
<translation id="682714496634566410">დაასათაურეთ თქვენი Alacrium პროფილი</translation>
<translation id="1927215335595997320">Alacrium წინასწარ ჩატვირთავს უფრო მეტ გვერდს, რომელთა ნახვასაც, სავარაუდოდ, დააპირებთ — ამგვარად, ამ გვერდებზე გადასვლისას, ისინი უფრო სწრაფად ჩაიტვირთება</translation>
<translation id="4344849281720725205">თუ თქვენს სანიშნეებს Google ანგარიშშიც ინახავთ, შეგიძლიათ თვალი მიადევნოთ პროდუქტების ფასებს Alacrium-ში და შეიტყოთ, როცა ფასი დაიკლებს</translation>
<translation id="2905944704289173754">მოახდინეთ Alacrium-ის სინქრონიზაცია და პერსონალიზება თქვენს ყველა მოწყობილობას შორის</translation>
<translation id="7023976647734322618">გაურთულეთ თქვენ მიერ მონახულებული საიტების შესახებ ინფორმაციის ნახვა მათ, ვისაც წვდომა აქვს თქვენს ინტერნეტ-ტრაფიკზე. Alacrium იყენებს უსაფრთო კავშირს საიტის IP მისამართის საპოვნელად DNS-ში (დომენური სახელების სისტემა).</translation>
<translation id="3124765553592510724">მისამართთა ზოლში ან საძიებო ველში ტექსტის აკრეფისას უკეთესი შემოთავაზებების მისაღებად Alacrium თქვენ მიერ აკრეფილ ტექსტს გაუგზავნის თქვენს ნაგულისხმევ საძიებო სისტემას. აღნიშნული ფუნქცია გამორთულია ინკოგნიტო რეჟიმში.</translation>
<translation id="5501994443630499490">დამატებითი დაცვის ჩართვა Alacrium-ის JavaScript-ისა და WebAssembly-ს ძრავაში</translation>
<translation id="3597078885567529815"><ph name="BEGIN_LINK" />Alacrium გაგაფრთხილებთ<ph name="END_LINK" /> არაუსაფრთხო საიტებისა და ჩამოტვირთვების შესახებ</translation>
<translation id="6539171476340543682">პაროლების შემოწმებას Alacrium შეძლებს მათი შენახვის შემდეგ</translation>
<translation id="5422284534340886571">Alacrium პროფილის დამატება</translation>
<translation id="5346310914638900016">Alacrium-ის პროფილების მართვა</translation>
<translation id="2601544977861663592">შედით Alacrium-ში</translation>
<translation id="4933700843989736491">შედით Alacrium-ში, როცა Google-ის სხვა სერვისებში შედიხართ</translation>
<translation id="7886351526956375471">ვინ იყენებს Alacrium-ს?</translation>
<translation id="6618835206810857815">საავტორო უფლება <ph name="YEAR" /> Alex313031. ყველა უფლება დაცულია.</translation>
