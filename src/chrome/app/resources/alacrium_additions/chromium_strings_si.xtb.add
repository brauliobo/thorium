<translation id="6170145535196286635">අඩවියක් ඒවායේ පිටුවේ සබැඳි පෞද්ගලිකව පූර්ව පූරණය කිරීමට ඉල්ලා සිටින විට, Alacrium Google සේවාදායක භාවිත කරයි. මෙය පූර්ව පූරණය කර ඇති අඩවියෙන් ඔබේ අනන්‍යතාව සඟවන නමුත්, Google පූර්ව පූරණය කරනු ලබන අඩවි මොනවා දැයි ඉගෙන ගනියි.</translation>
<translation id="469847031616755573">Alacrium ඔබේ පෙරනිමි බ්‍රව්සරය වේ</translation>
<translation id="9121116283800901015">Alacrium පිළිබඳ</translation>
<translation id="7557415942066581350"><ph name="USER_EMAIL" /> සමග Gmail හෝ YouTube වැනි Google සේවාවලට පුරන විට, ඔබට එම ගිණුමෙන්ම Alacrium වෙත ස්වයංක්‍රීයව පුරනය විය හැක</translation>
<translation id="8063674192889594521">ඔබගේ නව Alacrium පැතිකඩ පිහිටුවන්න</translation>
<translation id="2813532507332782105">Alacrium හි සුරක්ෂිතතා මෙවලම්</translation>
<translation id="5404516918685923379">Alacrium හි ප්‍රධාන පෞද්ගලිකත්ව සහ ආරක්ෂක පාලන සමාලෝචනය කරන්න</translation>
<translation id="391022854039785855">එය ඔබේ Google ගිණුම තුළ තබා ගන්නා අතර මෙම උපාංගයෙන් පමණක් බ්‍රවුස් කිරීමේ දත්ත මැකීමට, <ph name="BEGIN_LINK" />Alacrium වෙතින් වරන්න<ph name="END_LINK" />.</translation>
<translation id="232337676435179638">මෙය අක්‍රිය කිරීමෙන්, ඔබට Alacrium වෙත පුරනය නොවී Gmail වැනි Google වෙබ් අඩවිවලට පුරනය විය හැක.</translation>
<translation id="3879276044795274924">Alacrium අභිරුචිකරණය කරන්න</translation>
<translation id="6349701846617734224"><ph name="BEGIN_LINK" />Alacrium වෙතින් මෙවලම්<ph name="END_LINK" /> සමගින්, ඔබට සුරක්ෂිතව බ්‍රවුස් කර පාලනයේ සිටිය හැක</translation>
<translation id="113825514187113500">Alacrium තුළ</translation>
<translation id="2513495859821894442">ඔබේ සියලු උපාංග මත ඔබේ මුරපද සහ තවත් දේ ලබා ගැනීමට, Alacrium වෙත පුරන්න</translation>
<translation id="1290370037980749495">Alacrium ඉතා වේගයෙන් සහ සැලසුම් කළ පරිදි ජාවාස්ක්‍රිප්ට් භාවිත කළ යුතු විශේෂාංග ධාවන කරයි (නිර්දේශිතයි)</translation>
<translation id="3203458745325150724">ඔබේ Alacrium</translation>
<translation id="3892055234200984404">&amp;Alacrium පිළිබඳ</translation>
<translation id="8312332850957380094">වෙනත් Alacrium පැතිකඩ</translation>
<translation id="2823243626069255310">ඔබගේ නව Alacrium පැතිකඩ අභිරුචිකරණය කරන්න</translation>
<translation id="7057723382073894700">V8 යනු අඩවි කාර්යසාධනය දියුණු කිරීමට භාවිත කෙරෙන Alacrium හි ජාවාස්ක්‍රිප්ට සහ WebAssembly එන්ජිම වෙයි</translation>
<translation id="9073817226409915222">Alacrium වසා ඇති විට පසුබිම් යෙදුම් ධාවනය අඛණ්ඩව කරන්න</translation>
<translation id="5737116114768420447">Alacrium පැතිකඩවල් කළමනා කරන්න</translation>
<translation id="3390772469177266069">ඕනෑම දෙයකට ඔබේ සමාලෝචනය අවශ්‍ය නම් Alacrium ඔබට දන්වනු ඇත</translation>
<translation id="253414695030364725">Alacrium ඔබ පැමිණීමට ඉඩ ඇති පිටු පූර්ව පූරණය කරන බැවින්, ඔබ ඒවාට පැමිණෙන විට ඒවා වඩාත් ඉක්මනින් පූරණය වේ</translation>
<translation id="1965458093883218976">Alacrium ඔබව සුරක්ෂිතව තබන ආකාරය ඉගෙන ගන්න</translation>
<translation id="6097413908033623736"><ph name="BEGIN_LINK" />වත්මන් සැකසීම්<ph name="END_LINK" /> වාර්තා කිරීමෙන් Alacrium වඩා යහපත් කිරීමට උදවු වන්න</translation>
<translation id="7153173282073382515">Alacrium අප්‍රසිද්ධ</translation>
<translation id="1861871537231630745">සම්මත ආරක්ෂණයට වඩා අඩවිවලින් වැඩිපුර දත්ත විශ්ලේෂණය කිරීමෙන්, Google කලින් නොදැන සිටි ඒවා පවා, භයානක අඩවි පිළිබඳව ඔබට අනතුරු අඟවයි. ඔබට Alacrium අනතුරු ඇඟවීම් මඟ හැරීමට තේරිය හැක.</translation>
<translation id="8182056223343645142">Alacrium වෙතින් වරන්න</translation>
<translation id="4860412983011031251">Alacrium සමගින් උදවු ලබා ගන්න</translation>
<translation id="6079265919870015811">Alacrium පැතිකඩ එක් කරන්න</translation>
<translation id="7473833913849364138">Alacrium බ්‍රවුස් කිරීම සහ සෙවීම වේගවත් කරන පිටු පූර්ව පූරණය කරයි. <ph name="BEGIN_LINK" />පිටු පූර්ව පූරණය ගැන තව දැන ගන්න<ph name="END_LINK" /></translation>
<translation id="898934820356659708">ඔබ Alacrium පරිශීලන වාර්තාද බෙදා ගතහොත්, එම වාර්තාවලට ඔබ පිවිසෙන URL ඇතුළත් වේ</translation>
<translation id="9072534646955460921">Alacrium පැතිකඩවල් සමඟ ඔබට ඔබේ සියලු Alacrium දේවල් වෙන් කළ හැක. මිතුරන් සහ පවුලේ අය සඳහා පැතිකඩ තනන්න, නැතහොත් රැකියාව සහ විනෝදය අතර බෙදන්න.</translation>
<translation id="4308905027810063387">Alacrium වෙතින් වරන්න</translation>
<translation id="6312135329022974196">වෙනත් Alacrium පැතිකඩ</translation>
<translation id="8828163608353368128">Alacrium පුරනයට ඉඩ දෙන්න</translation>
<translation id="6497325017313227277">Alacrium වෙතින් ඉවත් කරන්න</translation>
<translation id="8315496929814159292">Alacrium ඔබේ පෙරනිමි බ්‍රව්සරය ලෙස සකසන්න</translation>
<translation id="438883585792992435">Alacrium අක්‍රිය පටිති වෙතින් මතකය නිදහස් කරයි. මෙය සක්‍රිය පටිති සහ අනෙකුත් යෙදුම්වලට වැඩි පරිගණක සම්පත් ලබා දෙන අතර Alacrium වේගවත්ව තබා ගනී. ඔබ ඒවා වෙත ආපසු යන විට ඔබේ අක්‍රිය පටිති ස්වයංක්‍රීයව නැවත සක්‍රිය වේ. <ph name="BEGIN_LINK" />මතක සුරකිනය පිළිබඳ තව දැන ගන්න<ph name="END_LINK" /></translation>
<translation id="1318664233874758685">Alacrium ඔබේ බ්‍රවුසරයට ආරක්‍ෂිතම සැකසීම් ඇති බව තහවුරු කිරීමට නිතිපතා පරීක්‍ෂා කරයි. අපි ඔබේ සමාලෝචනය අවශ්‍ය කිසිවක් තිබේ නම් ඔබට දන්වමු.</translation>
<translation id="4212981493728012253">ඔබේ දත්ත ආරක්ෂා කිරීම සඳහා, ඔබ මෑතක දී නොපැමිණි අඩවිවලින් අවසර ඉවත් කිරීමට Alacrium හට ඉඩ දෙන්න. දැනුම්දීම් නවත්වන්නේ නැත.</translation>
<translation id="3224040524634124542">ඔබ කුකීවලට ඉඩ දෙන්නේ නම්, පූර්ව පූරණය කිරීමේ දී Alacrium ඒවා භාවිත කිරීමට ඉඩ ඇත.</translation>
<translation id="1967056554017864811">ඔබගේ Alacrium පැතිකඩ අභිරුචිකරණය කරන්න</translation>
<translation id="682714496634566410">ඔබගේ Alacrium පැතිකඩ නම් කරන්න</translation>
<translation id="1927215335595997320">Alacrium ඔබ පැමිණීමට ඉඩ ඇති පිටු ඊටත් වඩා පෙර පූරණය කරන බැවින්, ඔබ ඒවාට පැමිණෙන විට ඒවා ඉක්මනින් පූරණය වේ.</translation>
<translation id="4344849281720725205">ඔබ ඔබේ Google ගිණුමේ ඔබේ පිටුසන් ද සුරැකුවහොත්, ඔබට Alacrium හි නිෂ්පාදන මිල ගණන් නිරීක්ෂණය කළ හැකි අතර මිල පහත වැටෙන විට දැනුවත් විය හැක</translation>
<translation id="2905944704289173754">ඔබගේ උපාංග හරහා Alacrium සමමුහුර්ත කර පෞද්ගලීකරණය කරන්න</translation>
<translation id="7023976647734322618">ඔබේ අන්තර්ජාල ගමනාගමනයට ප්‍රවේශය ඇති පුද්ගලයින්ට ඔබ පිවිසෙන්නේ කුමන අඩවි දැයි බැලීම අසීරු කරන්න. Alacrium DNS (වසම් නාම පද්ධතිය) තුළ වෙබ් අඩවියක IP ලිපිනය සෙවීමට ආරක්ෂිත සම්බන්ධතාවයක් භාවිතා කරයි.</translation>
<translation id="3124765553592510724">ඔබ ලිපින තීරුවේ හෝ සෙවීම් පෙට්ටියේ ටයිප් කරන විට, වඩා හොඳ යෝජනා ලබා ගැනීමට Alacrium ඔබ ටයිප් කරන දේ ඔබේ පෙරනිමි සෙවීම් යන්ත්‍රයට යවයි. මෙය අප්‍රසිද්ධ තුළ ක්‍රියා විරහිතයි.</translation>
<translation id="5501994443630499490">Alacrium හි ජාවාස්ක්‍රිප්ට සහ WebAssembly එන්ජිම තුළ අමතර ආරක්‍ෂාව සක්‍රීය කරන්න</translation>
<translation id="3597078885567529815"><ph name="BEGIN_LINK" />Alacrium ඔබට අනාරක්ෂිත අඩවි සහ බාගැනීම් ගැන අනතුරු අඟවයි<ph name="END_LINK" /></translation>
<translation id="6539171476340543682">Alacrium හට ඔබ ඔබේ මුරපද සුරකින විට ඒවා පරීක්ෂා කළ හැක</translation>
<translation id="5422284534340886571">Alacrium පැතිකඩ එක් කරන්න</translation>
<translation id="5346310914638900016">Alacrium පැතිකඩවල් කළමනා කරන්න</translation>
<translation id="2601544977861663592">Alacrium වෙත පිවිසෙන්න</translation>
<translation id="4933700843989736491">ඔබ වෙනත් Google සේවාවලට පුරන විට Alacrium වෙත පුරන්න</translation>
<translation id="7886351526956375471">Alacrium භාවිත කරමින් සිටින්නේ කවුද?</translation>
<translation id="6618835206810857815">කතෘ හිමිකම <ph name="YEAR" /> Alex313031. සියලුම හිමිකම් ඇවිරිණි.</translation>
