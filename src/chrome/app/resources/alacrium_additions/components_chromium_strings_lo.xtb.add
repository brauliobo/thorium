<translation id="6398664274442544385">ທ່ານກຳລັງເບິ່ງໜ້າ Alacrium ທີ່ປອດໄພ</translation>
<translation id="2028209743487670346">ໂລໂກ້ Alacrium</translation>
<translation id="7690933224612299375">Alacrium ເຮັດໃຫ້ເປັນໄປໄດ້ໂດຍ <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> ໂຄງການ open source ແລະ <ph name="BEGIN_LINK_OSS" />ຊອບແວ open source<ph name="END_LINK_OSS" /> ອື່ນໆ.</translation>
