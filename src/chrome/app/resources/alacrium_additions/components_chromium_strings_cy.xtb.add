<translation id="6398664274442544385">Rydych yn edrych ar dudalen Alacrium ddiogel</translation>
<translation id="2028209743487670346">Logo Alacrium</translation>
<translation id="7690933224612299375">Mae Alacrium yn bosib oherwydd prosiect ffynhonnell agored <ph name="BEGIN_LINK_CHROMIUM" />Chromium<ph name="END_LINK_CHROMIUM" /> a <ph name="BEGIN_LINK_OSS" />meddalwedd ffynhonnell agored<ph name="END_LINK_OSS" /> eraill.</translation>
